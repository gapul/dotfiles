{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "mobile/**/*.ts", "configs/**/*.ts", "windows/**/*.ts"],
  "exclude": ["node_modules", "configs/keyboard/karabiner"]
}
