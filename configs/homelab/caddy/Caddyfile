# gapul.net リバースプロキシ (Tailscale限定・LE証明書はCloudflare DNS-01)
#
# ── 共通スニペット (SSO) ──────────────────────────────────
# 変更はここ1箇所で全サイトに反映される。デプロイ前に必ず `caddy validate` を通すこと。
(tls_cf) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}

# Docker 母艦 (192.168.116.65) への proxy。母艦 IP はこの1行が唯一の定義点。
# 使い方: `import proxy65 <port>`  (IP が変わってもここだけ直せば全サービス追従)
(proxy65) {
	import tls_cf
	reverse_proxy 192.168.116.65:{args[0]}
}

home.gapul.net {
	import tls_cf
	reverse_proxy 192.168.116.88:8123 {
		header_up -X-Forwarded-For
	}
}

dockge.gapul.net {
	import proxy65 5001
}

pve.gapul.net {
	import tls_cf
	reverse_proxy https://192.168.116.100:8006 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

dash.gapul.net {
	import proxy65 3000
}

status.gapul.net {
	import tls_cf
	reverse_proxy 192.168.116.53:3001
}

wud.gapul.net {
	import proxy65 3002
}

vault.gapul.net {
	import proxy65 8080
}

rss.gapul.net {
	import proxy65 8081
}

obsidian.gapul.net {
	import proxy65 5984
}

dav.gapul.net {
	import proxy65 5232
}

pdf.gapul.net {
	import proxy65 8095
}

paperless.gapul.net {
	import proxy65 8097
}

# Forgejo (GitHub 以外の自宅 git ホスト)。HTTPS git のみ。
git.gapul.net {
	import proxy65 3003
}

# AdGuard Home 主系 (Raspberry Pi 4 / 制作用途で停止可)
dns.gapul.net {
	import tls_cf
	reverse_proxy 192.168.116.53:3000
}

# AdGuard Home 副系 (.65 / 常時稼働フェイルオーバー先)
dns2.gapul.net {
	import proxy65 3080
}

# Syncthing Web GUI (header_up Host は Syncthing の host チェック回避用)
sync.gapul.net {
	import tls_cf
	reverse_proxy 192.168.116.65:8384 {
		header_up Host {upstream_hostport}
	}
}

# ntfy (プッシュ通知。iOS即時通知のため server.yml に upstream-base-url=ntfy.sh 設定済)
ntfy.gapul.net {
	import proxy65 8082
}

# ArchiveBox (Webアーカイブ。非公開・Tailscale内のみ。CSRF_TRUSTED_ORIGINS設定済)
archive.gapul.net {
	import proxy65 8000
}

# Backrest (restic Web UI / スマホ閲覧用。Tailscale内のみ。Backrest自身も認証あり)
backrest.gapul.net {
	import proxy65 9898
}

# restic バックアップの中身を read-only でプレビュー (Filebrowser)。
# upstream は pve ホスト上の restic mount + Filebrowser (systemd)。詳細: configs/homelab/restic/README.md
files.gapul.net {
	import tls_cf
	reverse_proxy 192.168.116.100:8082
}

# 自前 Nix バイナリキャッシュ attic (CT101 dockge stack, host port 8083)。cachix 代替。
# pull は public=無認証、push は attic JWT トークン必須。詳細: memory homelab-attic-cache
cache.gapul.net {
	import proxy65 8083
}
