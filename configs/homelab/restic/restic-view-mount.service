[Unit]
Description=restic repo read-only FUSE mount (Filebrowser viewing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RCLONE_CONFIG=/root/.config/rclone/rclone.conf
Environment=RESTIC_REPOSITORY=rclone:google-drive:restic-backup
Environment=RESTIC_PASSWORD_FILE=/root/.restic.pw
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ExecStartPre=-/bin/fusermount -u /mnt/restic-view
ExecStart=/usr/bin/restic mount --no-lock --allow-other --no-default-permissions /mnt/restic-view
ExecStop=/bin/fusermount -u /mnt/restic-view
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
