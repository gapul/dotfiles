#!/usr/bin/env bash

source "$HOME/.config/sketchybar-colors.sh" # Loads all defined colors
source "$CONFIG_DIR/icons.sh" # Loads all defined icons

ITEM_DIR="$CONFIG_DIR/items" # Directory where the items are configured
PLUGIN_DIR="$CONFIG_DIR/plugins" # Directory where all the plugin scripts are stored

FONT="SF Pro" # Needs to have Regular, Bold, Semibold, Heavy and Black variants

# ─────────── プロファイル (main = 内蔵 / ext = 外部モニタ) ───────────
# 同じ config を 2 つの sketchybar インスタンスが読む。SB_PROFILE で寸法と描画先を切り替える。
# 背景: sketchybar はバー高さをディスプレイ別に持てない (notch_display_height だけは例外だが
# アイテム側の寸法には効かない)。内蔵はノッチ帯 56pt、外部のメニューバーは 24pt なので、
# 1 本のバーでは必ずどちらかが合わない。そこで別名バイナリでもう 1 インスタンス走らせ、
# バーごとに寸法を持たせる。items/plugins は bin-ext/sketchybar の PATH shim 経由で共用する。
SB_PROFILE="${SB_PROFILE:-main}"

# 外部インスタンスが描くディスプレイ番号 (display_watch.sh が事前計算してキャッシュする)。
# reload 中の自分自身には --query が効かないため、ここでは読むだけ。
EXT_DISPLAY_FILE=/tmp/sketchybar-ext-displays

# Setting up and starting the helper process
# helper は main インスタンスだけが持つ (mach port 名 git.felix.helper が固定で二重起動できず、
# sketchybar.h のクライアント側も git.felix.sketchybar 直書きなので ext からは使えない)。
if [ "$SB_PROFILE" = "main" ]; then
  HELPER=git.felix.helper
  killall helper
  (cd $CONFIG_DIR/helper && make)
  $CONFIG_DIR/helper/helper $HELPER > /dev/null 2>&1 &

  # Unload the macOS on screen indicator overlay for volume change
  launchctl unload -F /System/Library/LaunchAgents/com.apple.OSDUIHelper.plist > /dev/null 2>&1 &
fi

# ─────────── 解像度スケーリング ───────────
# 基準 1710x1112 (縦1112pt) に対し、論理"縦"解像度へ全サイズを比例スケール。
# バーは水平ストリップなので太さ/フォント/アイテム高はすべて「縦方向の量」= 縦解像度比でスケールする。
# (幅は width=max のデフォルトで自動的にディスプレイ幅いっぱいに伸びるためスケール不要)
#
# 複数ディスプレイ対応: main プロファイルはメインディスプレイ(内蔵)基準でスケールする。
# 外部モニタぶんは ext プロファイルが別インスタンスとして受け持つ (上のコメント参照)。
REF_H=1112
# メインディスプレイの論理縦(ポイント)と、メニューバー帯の高さを取得。
# 帯の高さ = frame と visibleFrame の差。ノッチ機ならノッチの高さ (この Mac では 56pt)、
# 通常のディスプレイなら 24pt。メニューバー自動非表示だと差が 0 になるので、その場合は既定の 24 に倒す。
# swift(AppKit)が最も確実、無ければ system_profiler で縦解像度だけ代替する。
read -r CUR_H MENU_H <<<"$(swift - <<'SWIFT' 2>/dev/null
import AppKit
// AppKit 座標では主ディスプレイの原点が (0,0)
let s = NSScreen.screens.first { $0.frame.origin == .zero } ?? NSScreen.screens.first
if let s {
  print(Int(s.frame.height), Int(s.frame.maxY - s.visibleFrame.maxY))
}
SWIFT
)"
if ! [ "${CUR_H:-0}" -gt 0 ] 2>/dev/null; then
  CUR_H=$(system_profiler SPDisplaysDataType 2>/dev/null | awk '
    /:$/ && /^ +[A-Za-z]/ { ll=""; res="" }
    /UI Looks like/ { ll=$0 }
    /Resolution:/   { res=$0 }
    /Main Display: Yes/ {
      line = (ll!="" ? ll : res)
      sub(/^.*:[ ]*/, "", line); sub(/ @.*/, "", line); sub(/ Retina.*/, "", line)
      gsub(/[^0-9x]/, "", line); split(line, a, "x"); print a[2]; exit
    }')
fi
[ "${CUR_H:-0}" -gt 0 ] 2>/dev/null || CUR_H=$REF_H
[ "${MENU_H:-0}" -gt 0 ] 2>/dev/null || MENU_H=24
# 寸法スケール。基準デザインはバー高さ 36pt で、そこからの倍率を 1 個の SCALE に集約する。
#   main: 縦解像度比。内蔵のノッチ帯にアイテムがちょうど収まる大きさになる。
#   ext : 外部モニタの macOS メニューバー (24pt) にバーを合わせる = 36 -> 24。
# FONT_SCALE は寸法とは別のフォント専用係数。基準デザインの文字/バー比 (14/36) は
# メニューバーの比 (13/24) より小さいので、ext では 1 より大きくして純正に寄せる。
if [ "$SB_PROFILE" = "ext" ]; then
  BAR_BAND=24
  SCALE=$(awk -v h="$BAR_BAND" 'BEGIN{printf "%.4f", h/36}')
  FONT_SCALE=1.25
else
  BAR_BAND=$MENU_H
  SCALE=$(awk -v c="$CUR_H" -v r="$REF_H" 'BEGIN{printf "%.4f", c/r}')
  FONT_SCALE=0.9
fi
# 整数へ丸めるスケール(寸法用) / 小数1桁のスケール(フォント用, FONT_SCALEを乗算)
sc()  { awk -v s="$SCALE" -v b="$1" 'BEGIN{printf "%.0f", b*s}'; }
scf() { awk -v s="$SCALE" -v b="$1" -v f="$FONT_SCALE" 'BEGIN{printf "%.1f", b*s*f}'; }

# バーはメニューバー帯そのものに重ねる (高さ = 帯、オフセット 0)。
# アイテムはバーの中で上下中央に置かれるので、これで pill の上下の余白が自動的に等しくなる。
# y_offset で下げると「上だけ空いて下は詰まっている」見え方になるため 0 固定。
BAR_HEIGHT=$BAR_BAND
Y_OFFSET=0
MARGIN=$(sc 8)
BAR_PAD=$(sc 10)
PADDINGS=$(sc 5)            # All paddings use this value (icon, label, background)
ICON_FONT_SIZE=$(scf 14)
LABEL_FONT_SIZE=$(scf 13)
BG_HEIGHT=$(sc 26)
BRACKET_BG_HEIGHT=$(sc 30)

# ─────────── 描画先ディスプレイ ───────────
# main はメインディスプレイ (= メニューバーを持つ画面。この構成では内蔵) だけ。
# ext はそれ以外の全ディスプレイ。番号は arrangement-id なので固定値では書けず、
# display_watch.sh がディスプレイ構成変化のたびに再計算してキャッシュしている。
if [ "$SB_PROFILE" = "ext" ]; then
  BAR_DISPLAY=$(cat "$EXT_DISPLAY_FILE" 2>/dev/null)
  # 外部モニタが無い / キャッシュ未生成のときは描かない。
  # (display 未指定の既定は all なので、これが無いと内蔵に小さいバーが二重に出る)
  if [ -z "$BAR_DISPLAY" ]; then
    BAR_DISPLAY=main
    BAR_HIDDEN=on
  fi
else
  BAR_DISPLAY=main
fi

# Setting up the general bar appearance of the bar
# バー全体は透明、各アイテムが個別にガラス風背景を持つ
bar=(
  height=$BAR_HEIGHT
  color=0x00000000               # バー本体は完全透明
  border_width=0
  border_color=0x00000000
  shadow=off
  position=top
  sticky=on
  padding_right=$BAR_PAD
  padding_left=$BAR_PAD
  y_offset=$Y_OFFSET
  margin=$MARGIN
  topmost=window
  display=$BAR_DISPLAY
  hidden=${BAR_HIDDEN:-off}
)

sketchybar --bar "${bar[@]}"

# Setting up default values
defaults=(
  updates=when_shown
  icon.font="$FONT:Regular:$ICON_FONT_SIZE"
  icon.color=$ICON_COLOR
  icon.padding_left=$PADDINGS
  icon.padding_right=$PADDINGS
  label.font="$FONT:Semibold:$LABEL_FONT_SIZE"
  label.color=$LABEL_COLOR
  label.padding_left=$PADDINGS
  label.padding_right=$PADDINGS
  label.shadow.drawing=on
  label.shadow.distance=2
  label.shadow.color=$SHADOW_COLOR
  padding_right=$PADDINGS
  padding_left=$PADDINGS
  background.height=$BG_HEIGHT
  background.corner_radius=9
  background.border_width=2
  background.color=0x00000000              # 個別pillは無効化(bracketで一括背景)
  background.border_color=0x00000000
  popup.background.border_width=2
  popup.background.corner_radius=9
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.color=$POPUP_BACKGROUND_COLOR
  popup.blur_radius=20
  popup.background.shadow.drawing=on
  scroll_texts=on

)

sketchybar --default "${defaults[@]}"


# Left
source "$ITEM_DIR/apple.sh"  # Apple ロゴ (左端。ワークスペースと同じ left_bracket の島に入る。popup: Preferences/Activity/Lock。zen.sh の状態判定も参照)
source "$ITEM_DIR/spaces.sh"

# Right
# right は「先に source したものほど右端」に並ぶ。表示は下から上へ読むと左→右になる。
# 右半分は macOS 純正メニューバーの並び (入力ソース → 画面ミラーリング → Bluetooth → Wi-Fi → 電池 → 時計) に合わせる。
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/bluetooth.sh"
source "$ITEM_DIR/screen_mirroring.sh"
source "$ITEM_DIR/input_source.sh"
# ここから左は自作アイテム
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/music.sh"

source "$ITEM_DIR/memory.sh"
source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/keystats.sh"
source "$ITEM_DIR/app_guard.sh"

# ─────────── 左右ブラケット背景 (ノッチを挟んで2分割) ───────────
sketchybar --add bracket left_bracket apple.logo '/space\..*/' \
           --set   left_bracket \
                   background.color=$BACKGROUND_1 \
                   background.corner_radius=10 \
                   background.border_width=1 \
                   background.border_color=$BAR_BORDER_COLOR \
                   background.height=$BRACKET_BG_HEIGHT \
                   background.padding_left=4 \
                   background.padding_right=4

sketchybar --add bracket right_bracket calendar battery wifi bluetooth screen_mirroring input_source volume_icon music memory cpu.percent keystats app_guard \
           --set   right_bracket \
                   background.color=$BACKGROUND_1 \
                   background.corner_radius=10 \
                   background.border_width=1 \
                   background.border_color=$BAR_BORDER_COLOR \
                   background.height=$BRACKET_BG_HEIGHT \
                   background.padding_left=4 \
                   background.padding_right=4

sketchybar --hotload on

# Forcing all item scripts to run (never do this outside of sketchybarrc)
sketchybar --update

echo "sketchybar configuation loaded.."
