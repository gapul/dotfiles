// markdownlint-cli2 グローバル設定
// レポート(日本語の地の文 + コードや対話ログが多い .md)向けに、
// 内容と無関係な体裁ルールを緩めて指摘のノイズを減らす。
// ホーム以下すべての Markdown に適用される(親方向の探索でここが拾われる)。
{
  "config": {
    // 行長制限。日本語は折り返さず1文が長くなりがちで、機械的に切る意味が薄い。
    "MD013": false,

    // コードブロックの言語指定必須。盤面図・実行結果・対話ログなど
    // 「言語が存在しない塊」が多く、当て字の text を強いるだけなので無効化。
    "MD040": false,

    // 先頭行が見出しであること。frontmatter から始まるレポートに合わない。
    "MD041": false,

    // 見出しの重複禁止。問ごとに「実装方針/動作例/考察」を再利用するため、
    // 同じ親の直下(兄弟)でのみ重複を禁止し、別の問での再利用は許可する。
    "MD024": { "siblings_only": true }
  }
}
