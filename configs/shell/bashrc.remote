# shellcheck shell=bash
#
# nssh 先 (Linux リモートホスト) 共通の bash 設定。
#
# 母艦 (macOS) は zsh + home-manager なのでこのファイルは読まれない。リモートは
# home-manager を通さず素の ~/.bashrc が動くため、そこから source して使う。
# source 行は configs/bin/nssh が初回接続時に追記する (marker 付き・冪等)。
#
# ここに置いてよいのは「どのリモートでも成り立つ汎用設定」だけ。
# このリポジトリは public なので、勤務先の内部構成 (サービス名・ポート・
# ビルド戦略など) を書いてはいけない。
# 案件固有のコマンドは案件ごとの private repo に置き、~/.devkits/<案件>/ に
# clone する (末尾の devkit ループが拾う)。

# ── PATH ────────────────────────────────────────────────────────────────────
# XDG のユーザーバイナリ置き場。再 source しても重複しないようガードする
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

# ── Rust ────────────────────────────────────────────────────────────────────
[ -r "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# ── rootless docker ─────────────────────────────────────────────────────────
if [ -S "/run/user/$(id -u)/docker.sock" ]; then
  export DOCKER_HOST="unix:///run/user/$(id -u)/docker.sock"
fi

# ── fnm (Node.js バージョン管理) ────────────────────────────────────────────
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd)"
fi

# ── ssh-agent ソケットの安定化 (ForwardAgent 用) ────────────────────────────
# nssh は -A で agent を転送するが、再接続のたびに転送 socket
# (/tmp/ssh-*/agent.PID) のパスが変わる。tmux のような長命プロセスは最初に掴んだ
# SSH_AUTH_SOCK を持ち続けるので、再接続後は死んだ socket を参照して git push 等が落ちる。
# そこで安定パス ~/.ssh/ssh_auth_sock に集約し、長命プロセスにはこちらを覚えさせる。
# 再接続後は symlink を貼り替えるだけで生き続ける。
_dotfiles_fix_ssh_agent() {
    local stable="$HOME/.ssh/ssh_auth_sock" s
    # いま掴んでいる SSH_AUTH_SOCK が実体 (非安定パス) で生きていれば安定パスへ反映
    if [ -S "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$stable" ] \
        && SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add -l >/dev/null 2>&1; then
        ln -snf "$SSH_AUTH_SOCK" "$stable"
    fi
    # 安定パスが死んでいたら、生きている最新の転送 socket を探して貼り替える
    # (socket 名に空白・改行は入らないため ls -t のまま扱える)
    if ! SSH_AUTH_SOCK="$stable" ssh-add -l >/dev/null 2>&1; then
        # shellcheck disable=SC2045
        for s in $(ls -t /tmp/ssh-*/agent.* 2>/dev/null); do
            if SSH_AUTH_SOCK="$s" ssh-add -l >/dev/null 2>&1; then
                ln -snf "$s" "$stable"; break
            fi
        done
    fi
    [ -S "$stable" ] && export SSH_AUTH_SOCK="$stable"
}
_dotfiles_fix_ssh_agent

# 上の関数はシェル起動時にしか走らない。tmux / herdr のペインは再接続しても新しい
# シェルを起動しないので、貼り替える者が誰もおらず、安定パスは死んだ socket を
# 指したままになる (2026-08-13 に git push が Permission denied で落ちた)。
# そこでプロンプトのたびに「より新しい転送 socket が来ていないか」だけを見る。
# 判定は glob と test だけで外部コマンドを呼ばず、生存確認 (ssh-add = 母艦への
# 往復) は実際に貼り替えるときにしか走らせない。
_dotfiles_refresh_ssh_agent() {
    # 直前のコマンドの終了ステータスを保存する。この関数は precmd / PROMPT_COMMAND から
    # starship より先に呼ばれるので、握り潰すとプロンプトの成否表示が常に成功になる。
    local __dotfiles_st=$?
    local stable="$HOME/.ssh/ssh_auth_sock" newest="" s
    for s in /tmp/ssh-*/agent.*; do
        [ -S "$s" ] || continue
        if [ -z "$newest" ] || [ "$s" -nt "$newest" ]; then newest="$s"; fi
    done
    # 実体が生きていて、それより新しい socket も無ければ何もしない (fork ゼロ)
    if [ -S "$stable" ] && { [ -z "$newest" ] || [ ! "$newest" -nt "$stable" ]; }; then
        return $__dotfiles_st
    fi
    if [ -n "$newest" ] && SSH_AUTH_SOCK="$newest" ssh-add -l >/dev/null 2>&1; then
        ln -snf "$newest" "$stable"
    else
        # newest が死んでいる等の例外は既存の総当たりに任せる
        _dotfiles_fix_ssh_agent
    fi
    [ -S "$stable" ] && export SSH_AUTH_SOCK="$stable"
    return $__dotfiles_st
}
case "${PROMPT_COMMAND:-}" in
    *_dotfiles_refresh_ssh_agent*) ;;
    *) PROMPT_COMMAND="_dotfiles_refresh_ssh_agent${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac

# ── 履歴 ────────────────────────────────────────────────────────────────────
# ディストロ既定の HISTSIZE=1000 では、少し前に打ったコマンドがすぐ消えて
# 履歴検索が用を成さない。fzf の Ctrl-R を活かすには母数が要る。
HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T '
shopt -s histappend cmdhist
# tmux で複数ペインを開くと、最後に閉じたシェルの履歴だけが残って他が消える。
# 実行のたびに追記して取りこぼしを防ぐ。
case "${PROMPT_COMMAND:-}" in
  *'history -a'*) ;;
  *) PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac

# 以降は対話シェル専用 (bind は非対話だとエラーになる)
if [[ $- == *i* ]]; then

  # ── readline ──────────────────────────────────────────────────────────────
  # ↑↓ を「打ちかけの文字列で前方一致検索」にする。zsh-autosuggestions のような
  # ゴーストテキストは bash 単体では出せないので、素の bash で一番近いのがこれ。
  # 例: `git com` まで打って ↑ → git com* で始まる履歴だけを遡る。
  bind '"\e[A": history-search-backward'
  bind '"\e[B": history-search-forward'
  bind 'set completion-ignore-case on'
  bind 'set completion-map-case on'   # - と _ を同一視
  bind 'set show-all-if-ambiguous on' # 1 回目の Tab で候補を出す
  bind 'set colored-stats on'
  bind 'set menu-complete-display-prefix on'

  # ── nix 側ツールの bash 補完 ──────────────────────────────────────────────
  # remote-env は git / rg / fd / bat / eza / yazi / zoxide の補完を
  # share/bash-completion/completions に同梱しているが、bash-completion は
  # システムのディレクトリしか見ないので拾われない。PATH から辿って明示的に読む。
  # 同じディレクトリを二度読まない (PATH には同じ prefix が重複して並ぶ)。
  # また同梱物が壊れていることがある (nixpkgs の rg.bash は Debian パッケージング由来の
  # パスを参照して失敗する) ので、1 つのしくじりで残りを巻き添えにしない。
  _dotfiles_load_nix_completions() {
    local dir comp file seen=":"
    local IFS=:
    for dir in $PATH; do
      [ "${dir%/bin}" != "$dir" ] || continue
      comp="${dir%/bin}/share/bash-completion/completions"
      [ -d "$comp" ] || continue
      case "$seen" in *":$comp:"*) continue ;; esac
      seen="$seen$comp:"
      for file in "$comp"/*; do
        [ -r "$file" ] || continue
        . "$file" 2>/dev/null || true
      done
    done
  }
  _dotfiles_load_nix_completions
  unset -f _dotfiles_load_nix_completions

  # ── fzf ───────────────────────────────────────────────────────────────────
  # Ctrl-R 履歴のあいまい検索 / Ctrl-T ファイル選択 / Alt-C ディレクトリ移動。
  # 母艦は programs.fzf の zsh 統合で入るが、リモートは bash なので自前で読む。
  if command -v fzf-share >/dev/null 2>&1; then
    _fzf_share="$(fzf-share)"
    [ -r "$_fzf_share/key-bindings.bash" ] && . "$_fzf_share/key-bindings.bash"
    [ -r "$_fzf_share/completion.bash" ] && . "$_fzf_share/completion.bash"
    unset _fzf_share
  fi
  # 一覧は fd に任せる (.gitignore を尊重し、.git を覗かない)
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  fi
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

  # ── zoxide ────────────────────────────────────────────────────────────────
  # よく行くディレクトリへ z <部分文字列> で飛ぶ。母艦は zsh 統合で入っている。
  if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
  fi

fi

# ── 案件ごとの devkit ───────────────────────────────────────────────────────
# 案件固有のコマンド (サービス名・ポート・ビルド戦略を含むもの) は当リポジトリが
# public なため置けない。かといって案件の共有リポジトリに個人設定を持ち込むのも
# 良くないので、案件ごとの private repo を ~/.devkits/<案件>/ に clone して使う。
#
# 規約は「ルートに shellrc を置く」だけ。ここは在るものを順に読むだけなので、
# 案件が増えても当リポジトリ側の変更は要らない (案件名も書かれない)。
#
# clone は自動化しない。どの devkit をどのホストに置くかはホスト側の判断であるべきで、
# 別案件のマシンに関係ない devkit が降ってくるのは望ましくない。
for _dk in "$HOME"/.devkits/*/shellrc; do
    [ -r "$_dk" ] && . "$_dk"
done
unset _dk
