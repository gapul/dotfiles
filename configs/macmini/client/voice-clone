#!/bin/zsh
# 母艦→macmini 透過・声クローン。参照音声の声で任意の日本語を喋らせる。
# 使い方: voice-clone <参照音声> "喋らせる文章" [出力.wav] ["参照文字起こし"]
# 環境変数 NOPLAY=1 で自動再生オフ
emulate -L zsh
ref="$1"; target="$2"; out="${3:-./cloned.wav}"; reftext="$4"
if [[ -z "$ref" || ! -f "$ref" || -z "$target" ]]; then
  echo "使い方: voice-clone <参照音声> \"文章\" [出力.wav] [\"参照文字起こし\"]"
  exit 1
fi
ext="${ref:e}"; tag="vc_$$"; rf="/tmp/${tag}.${ext}"
retry() { local i; for i in 1 2 3; do "$@" && return 0; sleep 2; done; return 1; }

echo "[send] 参照音声 → macmini"
retry scp -q "$ref" "macmini:$rf" || { echo "scp失敗"; exit 1; }
tb64="$(printf '%s' "$target" | base64)"
rtb64="$(printf '%s' "$reftext" | base64)"
echo "[run ] 声クローン合成(初回はAPI起動で時間がかかる)"
retry ssh macmini "tg=\$(echo '$tb64' | base64 -d); rt=\$(echo '$rtb64' | base64 -d); ~/.local/bin/voice-clone $rf \"\$tg\" /tmp/${tag}.wav \"\$rt\"" || { echo "合成失敗"; exit 1; }
retry scp -q "macmini:/tmp/${tag}.wav" "$out" || { echo "取得失敗"; exit 1; }
ssh macmini "rm -f /tmp/${tag}.*" >/dev/null 2>&1
echo "→ $out"
if [[ -z "$NOPLAY" ]] && command -v afplay >/dev/null; then afplay "$out"; fi
