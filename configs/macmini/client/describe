#!/bin/bash
# 母艦→macmini 透過・画像理解(Qwen3-VL)。ローカル画像を渡すだけで説明/質問。
# 使い方: describe <画像> ["プロンプト"]
img="$1"; prompt="$2"
if [[ -z "$img" || ! -f "$img" ]]; then
  echo "使い方: describe <画像> [\"プロンプト\"]"; exit 1
fi
# zsh の ${img:e} 相当: 最後のパス要素に . があればその後ろ、無ければ空
name="${img##*/}"; ext=""; [[ "$name" == *.* ]] && ext="${name##*.}"
tag="desc_$$"; rf="/tmp/${tag}.${ext}"
retry() { local _; for _ in 1 2 3; do "$@" && return 0; sleep 2; done; return 1; }
retry scp -q "$img" "macmini:$rf" || { echo "scp失敗"; exit 1; }
if [[ -n "$prompt" ]]; then
  pb64="$(printf '%s' "$prompt" | base64)"
  retry ssh macmini "p=\$(echo '$pb64' | base64 -d); ~/.local/bin/describe $rf \"\$p\""
else
  # shellcheck disable=SC2088 # ~ は macmini 側のシェルで展開させる
  retry ssh macmini "~/.local/bin/describe $rf"
fi
ssh macmini "rm -f $rf" >/dev/null 2>&1
