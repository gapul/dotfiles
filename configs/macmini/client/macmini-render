#!/bin/bash
# shellcheck disable=SC2029 # Job IDs and base64 arguments are expanded locally before ssh.
# Send a render/transcode to the Mac mini and bring back only the result.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  macmini-render ffmpeg INPUT OUTPUT [-- FFMPEG_OUTPUT_OPTIONS...]
  macmini-render blender PACKED_SCENE.blend OUTPUT_DIR [FRAME]
  macmini-render after-effects COLLECTED_DIR PROJECT.aep OUTPUT COMP

examples:
  macmini-render ffmpeg source.mov output.mp4 -- -c:v hevc_videotoolbox -tag:v hvc1 -c:a aac
  macmini-render blender scene.blend ./rendered 1
  macmini-render after-effects ./Collected project.aep output.mov "Main Comp"

Blender scenes must pack external assets (File > External Data > Pack Resources).
After Effects projects must use File > Dependencies > Collect Files first. PROJECT.aep is
relative to COLLECTED_DIR, so the collected assets keep their project-relative paths.
EOF
  exit 2
}
encode() { printf '%s' "$1" | /usr/bin/base64 | tr -d '\n'; }
ssh_options=(
  -o IdentityAgent=none
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o ClearAllForwardings=yes
  -i "$HOME/.ssh/id_automation"
)
scp_options=(
  -o IdentityAgent=none
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o ClearAllForwardings=yes
  -i "$HOME/.ssh/id_automation"
)
retry() {
  local attempt
  for attempt in 1 2 3; do
    "$@" && return 0
    [ "$attempt" = 3 ] || sleep 2
  done
  return 1
}

[ "$#" -ge 1 ] || usage
kind=$1
shift
job="$(date +%s)-$$"
remote="/tmp/macmini-render-$job"
cleanup() {
  /usr/bin/ssh "${ssh_options[@]}" macmini "/usr/bin/find '$remote' -depth -delete" \
    >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

case "$kind" in
  ffmpeg)
    [ "$#" -ge 2 ] || usage
    input=$1
    output=$2
    shift 2
    [ "${1:-}" != -- ] || shift
    [ -f "$input" ] || { echo "macmini-render: input not found: $input" >&2; exit 2; }
    input_name="input.${input##*.}"
    output_name="output.${output##*.}"
    retry /usr/bin/ssh "${ssh_options[@]}" macmini "/bin/mkdir -p '$remote'"
    retry /usr/bin/scp "${scp_options[@]}" -q "$input" "macmini:$remote/$input_name"
    options=()
    for arg in "$@"; do options+=("$(encode "$arg")"); done
    echo "[render] ffmpeg on macmini"
    /usr/bin/ssh "${ssh_options[@]}" macmini ~/.local/bin/macmini-render-worker ffmpeg "$job" \
      "$(encode "$input_name")" "$(encode "$output_name")" "${options[@]}"
    mkdir -p "$(dirname "$output")"
    retry /usr/bin/scp "${scp_options[@]}" -q "macmini:$remote/out/$output_name" "$output"
    echo "[done] $output"
    ;;
  blender)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
    input=$1
    output_dir=$2
    frame=${3:-1}
    [ -f "$input" ] || { echo "macmini-render: scene not found: $input" >&2; exit 2; }
    [[ "$frame" =~ ^[0-9]+$ ]] || usage
    input_name="scene.blend"
    retry /usr/bin/ssh "${ssh_options[@]}" macmini "/bin/mkdir -p '$remote'"
    retry /usr/bin/scp "${scp_options[@]}" -q "$input" "macmini:$remote/$input_name"
    echo "[render] Blender frame $frame on macmini"
    /usr/bin/ssh "${ssh_options[@]}" macmini ~/.local/bin/macmini-render-worker blender "$job" \
      "$(encode "$input_name")" "$frame"
    mkdir -p "$output_dir"
    retry rsync -a -e "/usr/bin/ssh -o IdentityAgent=none -o IdentitiesOnly=yes -o BatchMode=yes -o ClearAllForwardings=yes -i $HOME/.ssh/id_automation" \
      "macmini:$remote/out/" "$output_dir/"
    echo "[done] $output_dir"
    ;;
  after-effects)
    [ "$#" -eq 4 ] || usage
    project_dir=$1
    project_file=$2
    output=$3
    comp=$4
    [ -d "$project_dir" ] && [ ! -L "$project_dir" ] || {
      echo "macmini-render: collected project directory not found: $project_dir" >&2
      exit 2
    }
    case "$project_file" in /*|../*|*/../*|*/..) usage ;; esac
    [[ "$project_file" =~ ^[A-Za-z0-9_./[:space:]-]+\.aep$ ]] || usage
    [ -f "$project_dir/$project_file" ] || {
      echo "macmini-render: project not found inside collected directory: $project_file" >&2
      exit 2
    }
    [ -n "$comp" ] || usage
    output_name="render.${output##*.}"
    retry /usr/bin/ssh "${ssh_options[@]}" macmini "/bin/mkdir -p '$remote/project'"
    retry rsync -a -e "/usr/bin/ssh -o IdentityAgent=none -o IdentitiesOnly=yes -o BatchMode=yes -o ClearAllForwardings=yes -i $HOME/.ssh/id_automation" \
      "$project_dir/" "macmini:$remote/project/"
    echo "[render] After Effects comp '$comp' on macmini"
    /usr/bin/ssh "${ssh_options[@]}" macmini ~/.local/bin/macmini-render-worker after-effects "$job" \
      "$(encode "$project_file")" "$(encode "$output_name")" "$(encode "$comp")"
    mkdir -p "$(dirname "$output")"
    retry /usr/bin/scp "${scp_options[@]}" -q "macmini:$remote/out/$output_name" "$output"
    echo "[done] $output"
    ;;
  *) usage ;;
esac
