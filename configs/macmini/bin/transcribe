#!/bin/bash
# 文字起こし (sherpa-onnx: silero VAD + Parakeet ja / Cohere Transcribe)
# 使い方: transcribe <ファイル> [言語 ja/en/auto] [形式 txt/srt/vtt/json/all] [モデル fast|accurate]
#   fast     = Parakeet ja (日本語で最も正確・既定)
#   accurate = Cohere Transcribe (句読点が読みやすいが区間を落とすことがある。日本語以外はこちら)
# 出力は入力と同じ場所の <名前>.<形式>。モデルと選定の経緯は ~/.local/share/ai-stack/asr.py。
eval "$(/opt/homebrew/bin/brew shellenv)"
file="$1"; lang="${2:-ja}"; fmt="${3:-txt}"; model="${4:-fast}"
if [[ -z "$file" || ! -f "$file" ]]; then
  echo "使い方: transcribe <ファイル> [ja/en/auto] [txt/srt/vtt/json/all] [fast|accurate]"
  exit 1
fi
case "$model" in
  fast|parakeet)    model=parakeet ;;
  accurate|cohere)  model=cohere ;;
  *) echo "モデルは fast か accurate を指定"; exit 1 ;;
esac
# Parakeet は日本語専用。Cohere は言語の自動判定を持たないので auto は ja として扱う。
[[ "$lang" == "auto" ]] && lang=ja
[[ "$lang" != "ja" ]] && model=cohere
py="$HOME/.local/share/venvs/asr-venv/bin/python"
[[ -x "$py" ]] || { echo "asr-venv が無い (configs/macmini/bootstrap.sh)"; exit 1; }
base="${file%.*}"
wav="$(mktemp -t transcribe).wav"
trap 'rm -f "$wav"' EXIT
ffmpeg -nostdin -y -i "$file" -ar 16000 -ac 1 "$wav" >/dev/null 2>&1 || { echo "音声を読めない: $file"; exit 1; }
echo "[model=$model  lang=$lang  fmt=$fmt]"
"$py" ~/.local/share/ai-stack/asr.py "$wav" "$base" "$model" "$lang" "$fmt" || exit 1
echo "→ 出力先: $(dirname "$file")"
