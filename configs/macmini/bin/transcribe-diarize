#!/bin/bash
# 話者分離つき文字起こし: transcribe の区間ごとに話者埋め込みを取ってクラスタリング
# 使い方: transcribe-diarize <ファイル> [言語 ja/en/auto] [モデル fast|accurate] [しきい値 0.7]
#   しきい値: 2人が混ざるなら下げる、1人が割れるなら上げる。
# 出力は入力と同じ場所の <名前>.diarized.txt (と区間つきの <名前>.json)。
eval "$(/opt/homebrew/bin/brew shellenv)"
export PYTORCH_ENABLE_MPS_FALLBACK=1
file="$1"; lang="${2:-ja}"; model="${3:-fast}"; thr="${4:-0.7}"
if [[ -z "$file" || ! -f "$file" ]]; then
  echo "使い方: transcribe-diarize <ファイル> [ja/en/auto] [fast|accurate] [しきい値]"; exit 1
fi
base="${file%.*}"
~/.local/bin/transcribe "$file" "$lang" json "$model" || exit 1
wav="$(mktemp -t diarize).wav"
trap 'rm -f "$wav"' EXIT
ffmpeg -nostdin -y -i "$file" -ar 16000 -ac 1 "$wav" >/dev/null 2>&1
echo "[話者分離 threshold=$thr]"
~/.local/share/venvs/diarize-venv/bin/python ~/.local/share/ai-stack/diarize_cluster.py \
  "$wav" "$base.json" "$base.diarized.txt" "$thr" || exit 1
echo "→ 保存: $base.diarized.txt"
