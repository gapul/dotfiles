#!/usr/bin/env bash
#
# ssh 先から、母艦 Mac のアプリでファイルを開く。
#
# ssh 越しの yazi はプレビューまでは端末に出せるが、Enter で開く先の GUI がリモートに無い。
# ssh_config の RemoteForward で 127.0.0.1:$port が母艦の sshd に向いているので、そこへ
# scp で置いてから open を叩く。認証は Agent Forward 済みの鍵なので、リモートに秘密鍵は残らない。
#
# トンネルが無い環境 (Linux デスクトップ機など) ではその場で開く。yazi の opener は 1 つしか
# 実行されず候補に落ちてくれないので、フォールバックはこちら側で持つ。
#
#   open-on-mac [ローカルで開くときのコマンド...] -- <file>...
#
# `--` の前に書いたコマンドが、母艦に届かなかったときの開き先になる (省略時は xdg-open)。
# デスクトップ Linux で mpv や zathura を使っていたカテゴリは、それをそのまま渡すこと。

# shellcheck disable=SC2029 # パスはこちら側で展開して母艦に渡すのが意図
set -euo pipefail

port="${OPEN_ON_MAC_PORT:-2222}"
user="${OPEN_ON_MAC_USER:-gapul}"
host=127.0.0.1

ssh_opts=(-p "$port" -o BatchMode=yes -o StrictHostKeyChecking=accept-new
  -o UserKnownHostsFile=~/.ssh/known_hosts_open_on_mac)

# `--` までがローカルで開くときのコマンド。無ければ xdg-open。
local_cmd=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  local_cmd+=("$1")
  shift
done
if [ "${1-}" = "--" ]; then
  shift
else
  # `--` が無いなら全部ファイル扱い (ローカルは xdg-open)
  set -- "${local_cmd[@]}"
  local_cmd=()
fi
[ ${#local_cmd[@]} -eq 0 ] && local_cmd=(xdg-open)

if [ $# -eq 0 ]; then
  echo "Usage: open-on-mac [local command...] -- <file>..." >&2
  exit 1
fi

# 母艦に届かなければその場で開く。ssh が握って止まらないよう短く切る。
if ! ssh "${ssh_opts[@]}" -o ConnectTimeout=3 "$user@$host" true 2>/dev/null; then
  if command -v "${local_cmd[0]}" >/dev/null 2>&1; then
    exec "${local_cmd[@]}" "$@"
  fi
  echo "母艦へのトンネルが無く、${local_cmd[0]} も見つかりません" >&2
  exit 1
fi

# 見るためだけのコピーなので /tmp に置く。母艦の再起動で勝手に消える。
# 接続元ごとに分けて、同名ファイルを別ホストから開いても踏まないようにする。
dest="/tmp/open-on-mac/$(hostname -s)"
# 保険の掃除。母艦で常駐しているアプリ (Preview 等) に相乗りすると open -W はそれを畳むまで
# 返らないので、1 時間以上前のものはここで落とす。
ssh "${ssh_opts[@]}" "$user@$host" \
  "mkdir -p '$dest' && find '$dest' -type f -mmin +60 -delete 2>/dev/null || true"

for f in "$@"; do
  base=$(basename -- "$f")
  scp -q -P "$port" -o BatchMode=yes \
    -o UserKnownHostsFile=~/.ssh/known_hosts_open_on_mac \
    -- "$f" "$user@$host:$dest/$base"
  # ビューアを閉じたら消す。母艦側で完結させるので ssh はすぐ返る。
  # open -W が待つのはウィンドウではなくアプリの終了なので、既に起動しているアプリに
  # 相乗りした場合はそのアプリを畳むまで残る。次回の掃除で拾えるよう保険も置いてある。
  ssh "${ssh_opts[@]}" "$user@$host" \
    "nohup sh -c \"open -W '$dest/$base'; rm -f '$dest/$base'\" >/dev/null 2>&1 &"
done
