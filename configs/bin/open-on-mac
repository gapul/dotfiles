#!/usr/bin/env bash
#
# 遠くの yazi から、手元 (母艦 Mac) のアプリでファイルを開く。
#
# ssh 越しの yazi はプレビューまでは端末に出せるが、Enter で開く先の GUI が向こうに無い。
# ssh_config の RemoteForward で 127.0.0.1:$port が母艦の sshd に向いているので、そこへ
# scp で置いてから open を叩く。認証は Agent Forward 済みの鍵なので、向こうに秘密鍵は残らない。
#
#   open-on-mac [手元で開くときのコマンド...] -- <file>...
#
# 判定は OS ではなくセッションが遠いかどうかで持つ。ssh 先が Linux とは限らず、
# ヘッドレスな Mac (macmini) に入ることもあるので、yazi 側は for = macos/linux の区別ではなく
# 全部このスクリプトを通す。手元で動いているとき (SSH_CONNECTION 無し) や母艦に届かないときは、
# `--` の前に書いたコマンドでその場で開く (省略時は xdg-open)。yazi の opener は 1 つしか
# 実行されず候補に落ちてくれないので、フォールバックはこちら側で持つ。

# shellcheck disable=SC2029 # パスはこちら側で展開して母艦に渡すのが意図
set -euo pipefail

port="${OPEN_ON_MAC_PORT:-2222}"
user="${OPEN_ON_MAC_USER:-gapul}"
host=127.0.0.1

ssh_opts=(-p "$port" -o BatchMode=yes -o StrictHostKeyChecking=accept-new
  -o UserKnownHostsFile=~/.ssh/known_hosts_open_on_mac)

# `--` までが手元で開くときのコマンド。無ければ xdg-open。
local_cmd=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  local_cmd+=("$1")
  shift
done
if [ "${1-}" = "--" ]; then
  shift
else
  # `--` が無いなら全部ファイル扱い
  set -- "${local_cmd[@]}"
  local_cmd=()
fi
if [ ${#local_cmd[@]} -eq 0 ]; then
  # 手元が mac なら open、それ以外は xdg-open
  [ "$(uname -s)" = "Darwin" ] && local_cmd=(open) || local_cmd=(xdg-open)
fi

if [ $# -eq 0 ]; then
  echo "Usage: open-on-mac [local command...] -- <file>..." >&2
  exit 1
fi

open_here() {
  if command -v "${local_cmd[0]}" >/dev/null 2>&1; then
    exec "${local_cmd[@]}" "$@" >/dev/null 2>&1
  fi
  echo "${local_cmd[0]} が見つかりません" >&2
  exit 1
}

# 手元で動いているならそのまま開く。ssh を試すだけ無駄なので先に弾く。
[ -n "${SSH_CONNECTION-}" ] || open_here "$@"

# 母艦に届かなければその場で開く。ssh が握って止まらないよう短く切る。
ssh "${ssh_opts[@]}" -o ConnectTimeout=3 "$user@$host" true 2>/dev/null || open_here "$@"

src_host=$(hostname -s)

# 母艦が Unix とは限らない (Windows の母艦から ssh してくることもある)。
# Windows の sshd は既定シェルが cmd なので uname が通らないことで見分ける。
if ssh "${ssh_opts[@]}" "$user@$host" uname -s >/dev/null 2>&1; then
  # 見るためだけのコピーなので /tmp に置く。母艦の再起動で勝手に消える。
  # 接続元ごとに分けて、同名ファイルを別ホストから開いても踏まないようにする。
  dest="/tmp/open-on-mac/$src_host"
  # 保険の掃除。母艦で常駐しているアプリ (Preview 等) に相乗りすると open -W はそれを畳むまで
  # 返らないので、1 時間以上前のものはここで落とす。
  ssh "${ssh_opts[@]}" "$user@$host" \
    "mkdir -p '$dest' && find '$dest' -type f -mmin +60 -delete 2>/dev/null || true"

  for f in "$@"; do
    base=$(basename -- "$f")
    scp -q -P "$port" -o BatchMode=yes \
      -o UserKnownHostsFile=~/.ssh/known_hosts_open_on_mac \
      -- "$f" "$user@$host:$dest/$base"
    # ビューアを閉じたら消す。母艦側で完結させるので ssh はすぐ返る。
    # open -W が待つのはウィンドウではなくアプリの終了なので、既に起動しているアプリに
    # 相乗りした場合はそのアプリを畳むまで残る。次回の掃除で拾えるよう保険も置いてある。
    ssh "${ssh_opts[@]}" "$user@$host" \
      "nohup sh -c \"open -W '$dest/$base'; rm -f '$dest/$base'\" >/dev/null 2>&1 &"
  done
  exit 0
fi

# ここから先は母艦が Windows。cmd 経由でクォートを積むと必ず壊れるので、PowerShell は
# -EncodedCommand (UTF-16LE + base64) で送る。%TEMP% は cmd の変数で scp から見えないため、
# 置き場は ~/.cache 配下に取る (Windows でも $HOME は解決される)。
ps_exec() {
  local enc
  enc=$(printf '%s' "$1" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n')
  ssh "${ssh_opts[@]}" "$user@$host" "powershell -NoProfile -NonInteractive -EncodedCommand $enc"
}

win_rel=".cache\\open-on-mac\\$src_host"
ps_exec "\$d = Join-Path \$HOME '$win_rel'
New-Item -ItemType Directory -Force -Path \$d | Out-Null
Get-ChildItem \$d -File -ErrorAction SilentlyContinue |
  Where-Object { \$_.LastWriteTime -lt (Get-Date).AddHours(-1) } | Remove-Item -Force"

for f in "$@"; do
  base=$(basename -- "$f")
  scp -q -P "$port" -o BatchMode=yes \
    -o UserKnownHostsFile=~/.ssh/known_hosts_open_on_mac \
    -- "$f" "$user@$host:.cache/open-on-mac/$src_host/$base"
  # Start-Process -Wait は open -W と同じ性質で、待つのはウィンドウではなくプロセスの終了。
  # ssh を握らせないようこちら側でバックグラウンドに送る。
  ps_exec "\$p = Join-Path \$HOME '$win_rel\\$base'
Start-Process -Wait -FilePath \$p
Remove-Item -Force -ErrorAction SilentlyContinue \$p" >/dev/null 2>&1 &
done
