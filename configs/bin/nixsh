#!/usr/bin/env bash
#
# Native-speed Nix on a shared Linux box where nobody will give us /nix: a rootless-docker
# container from nixos/nix, /nix in a named volume, the real home bind-mounted at the same
# path. See docs/CHEATSHEET.md, "A shared Linux box, no sudo".
#
# home-manager is NOT activated in there. Its files would point into /nix/store, which only
# exists inside the container, and host-side readers (herdr, Claude Code, tmux) would break.
# Only the package set of homeConfigurations.<user>-linux-shared (config.home.path) is built
# and put on PATH; configs stay the remote-bootstrap symlinks into ~/.dotfiles, which resolve
# identically inside and outside.
#
# The container runs as root, which rootless docker maps to the host user, so files it
# writes into the home come out owned by us. USER/HOME are forced to match.
#
#   nixsh                 interactive zsh inside (bash until `nixsh update` has run), cwd kept
#   nixsh <cmd> [args]    run one command inside, cwd kept
#   nixsh update          rebuild the package set from ~/.dotfiles and collect garbage
#
# ponytail: no GPU passthrough (rootless docker has no nvidia runtime here); GPU work stays outside.
set -euo pipefail
name=nix
user=${USER:-$(id -un)}
home_path="$HOME/.local/state/nix/home-path"
sock="/run/user/$(id -u)/docker.sock"
[ -S "$sock" ] && export DOCKER_HOST="${DOCKER_HOST:-unix://$sock}"
env=(
  -e HOME="$HOME" -e USER="$user" -e ZDOTDIR="$HOME/.config/zsh"
  -e TERM="${TERM:-xterm-256color}"
  -e PATH="$home_path/bin:$HOME/.local/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin"
  -e NIX_CONFIG="experimental-features = nix-command flakes"
)
if ! docker container inspect "$name" >/dev/null 2>&1; then
  mkdir -p "$HOME/.local/state/nix/profiles"
  docker run -d --name "$name" --restart unless-stopped --network host \
    -v nixstore:/nix -v "$HOME:$HOME" -v /tmp:/tmp "${env[@]}" -w "$HOME" \
    nixos/nix sleep infinity >/dev/null
fi
docker start "$name" >/dev/null 2>&1 || true
case "${1:-}" in
  "")
    shell=bash; [ -L "$home_path" ] && shell=zsh
    exec docker exec -it "${env[@]}" -w "$PWD" "$name" "$shell" -l ;;
  update)
    exec docker exec -i "${env[@]}" "$name" sh -c \
      "nix build --out-link '$home_path' '$HOME/.dotfiles/nix#homeConfigurations.$user-linux-shared.config.home.path' && nix-collect-garbage -d >/dev/null" ;;
  *)
    exec docker exec -i "${env[@]}" -w "$PWD" "$name" "$@" ;;
esac
