#!/usr/bin/env bash
#
# iPhone 実機の画面を撮って操作する。WebDriverAgent (WDA) の REST を直接叩く。
#
#   ios start            WDA を起動 (xcodebuild test をバックグラウンドで走らせる)
#   ios stop             WDA を落とす
#   ios status           生死と接続先
#   ios shot [file]      スクリーンショット (既定 /tmp/ios.png)
#   ios tap X Y          タップ
#   ios swipe X1 Y1 X2 Y2
#   ios type "text"      フォーカス中の要素に入力
#   ios open <bundleid>  アプリを起動 (セッションを張り直す)
#   ios url <url>        URL / ディープリンクを開く
#   ios source           画面の要素ツリー
#   ios home             ホーム画面へ
#   ios bootstrap        WDA プロジェクトを取ってくる (初回のみ)
#
# 座標は論理ポイント。スクリーンショットは物理ピクセルなので、拾った座標を
# スケール (iPhone 16 なら 3) で割ってから渡す。
#
# Appium は挟まない。iOS 26 では Appium の XCUITest ドライバがセッションを張れず
# (appium/appium#21643)、WDA 単体なら通るため。署名は Xcode の自動署名に
# App Store Connect の API キーを渡して解決する。手で作ったプロファイルを
# xcconfig で指定すると WebDriverAgentLib が「フレームワークはプロファイル非対応」で落ちる。
#
# 前提: iPhone の自動ロックを「なし」にしておく。ロック中は XCTest のランナーが
# SIGKILL され、WDA が数十秒で消える。低電力モードは自動ロックを 30 秒に固定するので、
# 併せて切っておく。接続はワイヤレス (tailnet か同一 LAN) で足りる。
set -u

UDID="${IOS_UDID:-00008140-00154CE21468401C}"
TEAM="${IOS_TEAM:-S3H296G6Q5}"
ASC_KEY="${IOS_ASC_KEY:-$HOME/.appstoreconnect/private_keys/AuthKey_89H54N7QAK.p8}"
ASC_KEY_ID="${IOS_ASC_KEY_ID:-89H54N7QAK}"
ASC_ISSUER="${IOS_ASC_ISSUER:-ed768b18-d4cd-4ed4-ba15-f0360ea93f5a}"
# tailnet を先に試して、届かなければ LAN。IOS_HOSTS で上書きできる。
HOSTS="${IOS_HOSTS:-100.107.156.128 192.168.1.54}"

ROOT="$HOME/.local/share/ios-automation"
PROJ="$ROOT/WebDriverAgent"
STATE="$HOME/.local/state/ios-automation"
LOG="$STATE/wda.log"
mkdir -p "$STATE"

_find_host() {
  # 起動ログの ServerURLHere を優先し、無ければ既知のアドレスを順に叩く
  local h
  for h in $(sed -n 's/.*ServerURLHere->http:\/\/\([^:]*\):8100.*/\1/p' "$LOG" 2>/dev/null | tail -1) $HOSTS; do
    [ -z "$h" ] && continue
    # 2 秒では足りない。iPhone が外の回線にいると tailnet は DERP リレー経由になり、
    # 往復に 1 秒以上かかる。実際 WDA は応答しているのに down と判定されていた。
    if [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "http://$h:8100/status")" = "200" ]; then
      echo "$h"
      return 0
    fi
  done
  return 1
}

_wda() { echo "http://$(cat "$STATE/host")":8100; }
_sid() { cat "$STATE/sid" 2>/dev/null; }

_new_session() {
  local bundle="$1" body='{"capabilities":{"alwaysMatch":{}}}'
  [ -n "$bundle" ] && body="{\"capabilities\":{\"alwaysMatch\":{\"bundleId\":\"$bundle\"}}}"
  curl -s -X POST "$(_wda)/session" -H 'Content-Type: application/json' -d "$body" |
    python3 -c 'import json,sys; print(json.load(sys.stdin).get("sessionId",""),end="")' > "$STATE/sid"
  [ -s "$STATE/sid" ] || {
    echo "ios: セッションを張れなかった" >&2
    exit 1
  }
}

_ensure() {
  local h
  h=$(_find_host) || {
    echo "ios: WDA が応答しない。'ios start' を実行 (画面がロックされていないかも確認)" >&2
    exit 1
  }
  echo -n "$h" > "$STATE/host"
  [ -s "$STATE/sid" ] || _new_session ""
}

# $1 = actions 配列の中身
_actions() {
  curl -s -X POST "$(_wda)/session/$(_sid)/actions" -H 'Content-Type: application/json' \
    -d "{\"actions\":[{\"type\":\"pointer\",\"id\":\"f1\",\"parameters\":{\"pointerType\":\"touch\"},\"actions\":[$1]}]}" > /dev/null
}

case "${1:-}" in
  bootstrap)
    mkdir -p "$ROOT"
    # WDA のソースは Appium が配っているものをそのまま使う (npm 経由)
    (cd "$ROOT" && npm install --silent --no-save appium-webdriveragent) || exit 1
    rm -rf "$PROJ" && mv "$ROOT/node_modules/appium-webdriveragent" "$PROJ"
    echo "ios: $PROJ を用意した"
    ;;
  start)
    [ -d "$PROJ" ] || {
      echo "ios: $PROJ が無い。'ios bootstrap' を先に実行" >&2
      exit 1
    }
    pgrep -f "xcodebuild -project $PROJ/WebDriverAgent.xcodeproj" > /dev/null && {
      echo "ios: すでに起動している"
      exit 0
    }
    rm -f "$STATE/sid"
    (cd "$PROJ" && nohup xcodebuild -project WebDriverAgent.xcodeproj -scheme WebDriverAgentRunner \
      -destination "id=$UDID" -allowProvisioningUpdates \
      -authenticationKeyPath "$ASC_KEY" -authenticationKeyID "$ASC_KEY_ID" -authenticationKeyIssuerID "$ASC_ISSUER" \
      DEVELOPMENT_TEAM="$TEAM" PRODUCT_BUNDLE_IDENTIFIER=net.gapul.WebDriverAgentRunner \
      test > "$LOG" 2>&1 &)
    for i in $(seq 1 90); do
      if h=$(_find_host); then
        echo -n "$h" > "$STATE/host"
        echo "ios: up http://$h:8100 (${i}s)"
        exit 0
      fi
      sleep 1
    done
    echo "ios: 起動に失敗。$LOG を見る (ロック中なら即死ぬ)" >&2
    exit 1
    ;;
  stop)
    pkill -f "xcodebuild -project $PROJ/WebDriverAgent.xcodeproj" 2> /dev/null
    rm -f "$STATE/sid"
    echo "ios: stopped"
    ;;
  status)
    if h=$(_find_host); then echo "ios: up http://$h:8100"; else
      echo "ios: down"
      exit 1
    fi
    ;;
  shot)
    _ensure
    out="${2:-/tmp/ios.png}"
    curl -s "$(_wda)/screenshot" |
      python3 -c "
import base64, json, sys
open('$out', 'wb').write(base64.b64decode(json.load(sys.stdin)['value']))
" && echo "$out"
    ;;
  tap)
    _ensure
    _actions "{\"type\":\"pointerMove\",\"duration\":0,\"x\":$2,\"y\":$3},{\"type\":\"pointerDown\",\"button\":0},{\"type\":\"pause\",\"duration\":80},{\"type\":\"pointerUp\",\"button\":0}"
    ;;
  swipe)
    _ensure
    _actions "{\"type\":\"pointerMove\",\"duration\":0,\"x\":$2,\"y\":$3},{\"type\":\"pointerDown\",\"button\":0},{\"type\":\"pointerMove\",\"duration\":400,\"x\":$4,\"y\":$5},{\"type\":\"pointerUp\",\"button\":0}"
    ;;
  type)
    _ensure
    curl -s -X POST "$(_wda)/session/$(_sid)/wda/keys" -H 'Content-Type: application/json' -d "{\"value\":[\"$2\"]}" > /dev/null
    ;;
  open)
    _ensure
    _new_session "$2"
    echo "ios: session $(_sid)"
    ;;
  url)
    _ensure
    curl -s -X POST "$(_wda)/session/$(_sid)/url" -H 'Content-Type: application/json' -d "{\"url\":\"$2\"}" > /dev/null
    ;;
  source)
    _ensure
    curl -s "$(_wda)/source?format=description"
    ;;
  home)
    _ensure
    curl -s -X POST "$(_wda)/wda/homescreen" > /dev/null
    ;;
  *) sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
