#!/usr/bin/env bash
# TCC の許可が rebuild で消えないよう、安定した場所に署名付きで置く。
#
# 問題は 2 つ重なっている。
#   1. nix のストアパスは更新のたびに変わる。TCC は場所で識別するので許可が切れる。
#   2. ad-hoc 署名だと同一性が cdhash になる。中身が変われば別物になる。
#
# なので「場所を固定」して「Developer ID で署名」する。Developer ID の署名は
# 「この identifier で、この証明書で署名されたもの」という要件になるので、
# 中身が変わっても同じものとみなされる。
#
# 使い方: tcc-stable-binary <元のバイナリ> <安定した名前>
set -euo pipefail

SRC="${1:?元のバイナリ}"
NAME="${2:?安定した名前}"
DEST_DIR="$HOME/.local/libexec/tcc"
DEST="$DEST_DIR/$NAME"

# 自己署名の専用 identity を使う。Developer ID ではないのは、TCC が Apple 発行か
# どうかを見ていないから — 要件式に cdhash が入らないことだけが効いている
# (実測で確認)。コード署名の鍵は用途を絞るほど安全で、macmini のように外向きの
# サービスが多い機械に Developer ID の秘密鍵を置かずに済む。
#
# 無ければ何もしない。tcc-signing-identity を機械ごとに一度走らせること。
# 専用キーチェーンは再起動で施錠される。解錠しないと署名が
# 「identity が無い」に見えて黙って何もしないまま終わる。
PWFILE="$HOME/.config/tcc-keychain.password"
if [ -s "$PWFILE" ] && [ -e "$HOME/Library/Keychains/tcc.keychain-db" ]; then
  /usr/bin/security unlock-keychain -p "$(cat "$PWFILE")" tcc.keychain 2>/dev/null || true
fi

# 名前ではなくハッシュで指す。同名の証明書が複数のキーチェーンにあると
# codesign が ambiguous で止まる。
SHAFILE="$HOME/.config/tcc-signing.sha1"
if [ ! -s "$SHAFILE" ]; then
  echo "tcc-stable-binary: 署名 identity が無い。tcc-signing-identity を先に実行" >&2
  exit 0
fi
IDENTITY=$(cat "$SHAFILE")

/bin/mkdir -p "$DEST_DIR"

# 中身が同じなら触らない。署名し直すと cdhash が変わらなくても
# ファイルの mtime が動いて、TCC が再評価する余地を作る。
if [ -e "$DEST" ] && /usr/bin/cmp -s "$SRC" "$DEST"; then
  exit 0
fi

/usr/bin/install -m 0755 "$SRC" "$DEST"

# --identifier を固定するのが肝。既定だとファイル名から推測されるが、
# 明示しておかないと将来のバージョンで変わりうる。
#
# エラーを握り潰さない。未署名のまま安定パスに残ると TCC は cdhash で識別する
# ことになり、許可が切れる — 何もしないより悪い。失敗したら消す。
# (activation の PATH に /usr/bin が無くて codesign が見つからず、静かに
#  未署名のコピーだけが残る状態を実際に作ってしまった。だから絶対パスで呼ぶ)
# --options runtime (hardened runtime) は付けない。付けるとライブラリ検証が
# 有効になり、nix store の ad-hoc 署名された dylib を読み込めなくなる。
# sunshine が dyld の "Library not loaded ... code signature" で即死した。
# TCC の要件式は署名 identity で決まるので、hardened runtime は要らない。
if ! /usr/bin/codesign --force --sign "$IDENTITY" \
  --identifier "net.gapul.tcc.$NAME" \
  --timestamp=none \
  "$DEST"; then
  /bin/rm -f "$DEST"
  echo "tcc-stable-binary: $NAME の署名に失敗した。未署名を残さないよう消した" >&2
  exit 1
fi

echo "tcc-stable-binary: $NAME を署名して $DEST に置いた"
