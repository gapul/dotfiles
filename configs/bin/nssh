#!/usr/bin/env bash
#
# SSH 接続先で rootless Nix (nix-portable) を立ち上げて、
# 自分の dotfiles 設定で nvim / yazi / tmux を使う。
#
# 流れ:
#   1. nix-portable バイナリを ~/.local/bin に展開(初回のみ)
#   2. dotfiles を SSH 経由で git clone (初回) または git pull
#      → SSH Agent Forward (-A) でローカルの鍵を使う、リモートに鍵不要
#   3. ~/.config/{nvim,yazi,tmux} を dotfiles に symlink
#   4. ~/.bashrc に configs/shell/bashrc.remote を source する行を追記 (冪等)
#   5. nix-portable nix shell .#remote-env -c tmux でセッション開始
#   6. 切断後に mutagen のペアリングを確認 (macOS のみ。zsh の ssh ラッパーと同じ役割)
#
# tmux は new -A で attach-or-create するので、切断しても入り直せば同じセッションに戻る。
# リモートは home-manager 非経由なので、tmux 設定のうち nix の生成物に依存する部分は
# リポジトリ側で肩代わりしている。届くもの / 届かないものは以下のとおり:
#   - キーバインド・基本設定 : tmux.conf 本体がそのまま効く
#   - rose-pine テーマ       : configs/terminals/tmux/theme-remote.conf (active パレット固定。
#                              母艦のライト/ダーク自動追従だけは無い)
#   - prefix+e (スクロールバック編集) : configs/terminals/tmux/scrollback-edit.sh
#   - プラグイン (resurrect / continuum) : 無効。セッション永続化は使い捨てホストの
#     前提 (reset --hard) と噛み合わないため、意図的に持ち込まない。

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: nssh <user@host> [extra ssh args...]" >&2
  exit 1
fi

host="$1"
shift

# tmux のペインは $SHELL を起動する。リモートのログインシェルは bash なので、
# nix shell の中で zsh を掴ませて母艦と同じ環境にする。ZDOTDIR を渡さないと
# zsh は ~/.zshrc を読んでしまい、dotfiles の設定が効かない。
# zsh が無い環境 (remote-env が古い等) では黙って既定のシェルに落ちる。
#
# nix shell -c は argv をそのまま exec するのでシェルを通らない。変数代入を前置しても
# "SHELL=/bin/bash" という名前のコマンドを探しに行って落ちる。sh -c で包むこと。
# zsh は remote-env の中にしか居ないので、command -v も内側で走らせる必要がある
# (外側のログインシェルで展開すると必ず bash に落ちる)。
remote_mux='sh -c '\''SHELL="$(command -v zsh || echo "$SHELL")" ZDOTDIR="$HOME/.config/zsh" exec tmux new -A -s nssh'\'''

# ローカルの dotfiles から remote URL を取得(fork した人もそのまま使える)
DOTFILES_URL=$(git -C "$HOME/.dotfiles" remote get-url origin 2>/dev/null || \
                echo "git@github.com:gapul/dotfiles.git")

# Agent Forwarding を必ず付ける (-A) と StrictHostKey で github の自動信頼
ssh -A "$host" "$@" "DOTFILES_URL='$DOTFILES_URL' bash -s" <<'BOOTSTRAP'
set -euo pipefail
mkdir -p ~/.local/bin ~/.config
arch=$(uname -m)

# 1. nix-portable
if [ ! -x ~/.local/bin/nix-portable ]; then
  echo "[nssh] Installing nix-portable for ${arch}..."
  curl -fsSL "https://github.com/DavHau/nix-portable/releases/latest/download/nix-portable-${arch}" \
    -o ~/.local/bin/nix-portable
  chmod +x ~/.local/bin/nix-portable
fi

# 2. dotfiles (SSH URL を使い、Agent Forward で local 鍵を流用)
#    初回のみ github.com の host key を known_hosts に自動追加
if ! grep -q "^github.com " ~/.ssh/known_hosts 2>/dev/null; then
  ssh-keyscan -t ed25519,rsa github.com >> ~/.ssh/known_hosts 2>/dev/null || true
fi
if [ ! -d ~/.dotfiles/.git ]; then
  echo "[nssh] Cloning dotfiles ($DOTFILES_URL)..."
  git clone "$DOTFILES_URL" ~/.dotfiles
else
  # リモートは使い捨て前提なので origin に強制で合わせる。
  # pull --rebase だと lazy-lock.json 等の差分で黙って失敗し、古いまま使い続けることになる。
  git -C ~/.dotfiles fetch --quiet origin && git -C ~/.dotfiles reset --hard --quiet '@{u}' \
    || echo "[nssh] WARNING: dotfiles の更新に失敗。既存の clone のまま続行します。" >&2
fi

# 3. config symlinks
ln -sfn ~/.dotfiles/configs/editors/nvim     ~/.config/nvim
ln -sfn ~/.dotfiles/configs/cli/yazi         ~/.config/yazi
ln -sfn ~/.dotfiles/configs/terminals/tmux   ~/.config/tmux
#    gh と codex は設定と同じディレクトリに認証情報 (hosts.yml / auth.json) を置くため、
#    ディレクトリごとではなく設定ファイル単体を張る。認証情報はホスト側に残す。
#    どちらもツール自身が設定を書き戻すことがあるが、その書き込みは dotfiles の
#    working tree に落ちて次回接続の reset --hard で消える (nvim の lazy-lock.json と同じ扱い)。
mkdir -p ~/.config/gh ~/.codex
ln -sfn ~/.dotfiles/configs/cli/gh/config.yml     ~/.config/gh/config.yml
ln -sfn ~/.dotfiles/configs/cli/codex/config.toml ~/.codex/config.toml
#    zsh: ZDOTDIR を ~/.config/zsh に置き、.zshrc を dotfiles へ向ける。
#    ログインシェルは bash のまま (共有マシンでは chsh できない) なので、
#    素の ssh で入ったときは bashrc.remote が使われる。
mkdir -p ~/.config/zsh
ln -sfn ~/.dotfiles/configs/shell/zshrc.remote ~/.config/zsh/.zshrc

# 4. shell rc: dotfiles 側の共通 bash 設定を ~/.bashrc から読ませる (marker 付き・冪等)
#    リモートは home-manager を通らないので ~/.bashrc 本体は各ホストのものが動く。
#    そこに source 行を 1 行だけ足しておけば、中身は dotfiles 側 (reset --hard で毎回最新)
#    に寄せられる。ホスト固有の設定は marker の外にそのまま残る。
marker='# >>> dotfiles bashrc.remote >>>'
if [ -f ~/.bashrc ] && ! grep -qF "$marker" ~/.bashrc; then
  {
    echo ""
    echo "$marker"
    echo '[ -r "$HOME/.dotfiles/configs/shell/bashrc.remote" ] && . "$HOME/.dotfiles/configs/shell/bashrc.remote"'
    echo '# <<< dotfiles bashrc.remote <<<'
  } >> ~/.bashrc
  echo "[nssh] ~/.bashrc に dotfiles の bash 設定を読む行を追記しました"
fi
BOOTSTRAP

# 5. インタラクティブ接続 ($HOME はリモート側で展開される)
#    path:~/.dotfiles/nix を flake source に (private repo を GitHub API なしで使う)
#    exec しないのは 6 を走らせるため。終了コードは ssh のものをそのまま返す。
rc=0
ssh -At "$host" "$@" \
  '"$HOME"/.local/bin/nix-portable nix shell "path:$HOME/.dotfiles/nix#remote-env" -c '"$remote_mux" || rc=$?

# 6. mutagen のペアリング確認 (macOS のみ。home/mutagen-sync.nix が入れるコマンド)
#    zsh の ssh ラッパーと同じ扱いにする。あちらは `ssh` にしか掛からず、nssh は bash
#    スクリプトなので中の ssh はバイナリに解決される。結果 nssh で入ったホストだけ
#    ~/Sync のペアが作られず、ファイル授受のためだけに素の ssh を打ち直す必要があった。
#
#    必ずセッション終了後・バックグラウンドで、出力も終了コードも呼び出し元に影響させない。
#    接続中にやると Bitwarden agent の承認が再度走り、ポートフォワードを持つホストでは
#    2 本目の接続自体が失敗する (mutagen-sync.nix のコメント参照)。
#    ensure 側は marker + `mutagen sync list` で冪等なので、多重に呼んでも害はない。
#    空のペアを退役させる掃除も ensure 側が持っているため、ここでは何も判断しない。
if command -v mutagen-sync-ensure >/dev/null 2>&1; then
  (mutagen-sync-ensure "$host" &) >/dev/null 2>&1
fi

exit "$rc"
