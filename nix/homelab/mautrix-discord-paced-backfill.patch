@@ -107,6 +109,20 @@ func (portal *Portal) ForwardBackfillMissed(source *User, serverLastMessageID st
 
 const messageFetchChunkSize = 50
 
+// backfillRequestDelay paces message history fetches so that catching up after a long outage
+// does not fire thousands of requests back to back, which no first-party client would do.
+const backfillRequestDelay = 3 * time.Second
+
+// missedBackfillDone holds back live message handling until the first READY's missed message
+// backfill has finished. Otherwise a live message that arrives in a channel before its turn
+// becomes the last bridged message, and the backfill sees nothing to catch up.
+var missedBackfillDone = make(chan struct{})
+var missedBackfillDoneOnce sync.Once
+
+func finishMissedBackfill() {
+	missedBackfillDoneOnce.Do(func() { close(missedBackfillDone) })
+}
