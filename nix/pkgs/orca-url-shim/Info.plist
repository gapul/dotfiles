<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>net.gapul.orcaurlshim</string>
  <key>CFBundleName</key><string>OrcaURLShim</string>
  <key>CFBundleExecutable</key><string>OrcaURLShim</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <!-- No dock icon and no app switcher entry: this process lives for a fraction of a second. -->
  <key>LSUIElement</key><true/>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>Bambu Studio open URL</string>
      <!-- Bambu Studio's own Info.plist claimed "bambustudioopen" while its binary parsed
           "bambustudio://open". Which one MakerWorld emits was never pinned down, so claim
           both. -->
      <key>CFBundleURLSchemes</key>
      <array><string>bambustudio</string><string>bambustudioopen</string></array>
    </dict>
  </array>
</dict>
</plist>
