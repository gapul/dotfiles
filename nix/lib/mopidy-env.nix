# Mopidy runtime environment (a python env bundling the core + extensions + yt-dlp into a single site-packages).
# Imported by both the declarative module home/mopidy.nix and macmini's self-driving test mirror to
# share the same definition (prevents drift in patch application).
#
# Plain nixpkgs mopidy-ytmusic / mopidy-mpd / mopidy-listenbrainz fall short against current YouTube/rmpc,
# so we bake in build-time patches from configs/media/mopidy/*.py.
# To add a new patch, just append it to the target extension's patch list.
# patchDir is the separate repo gapul/mopidy-rmpc-patches (flake input mopidy-patches).
{ pkgs, patchDir }:
let
  inherit (pkgs) lib;
  py = pkgs.python3;
  toM = py.pkgs.toPythonModule;

  # Apply the python patches to the extension in order as postPatch
  mkPatched =
    pkg: scripts:
    pkg.overrideAttrs (old: {
      postPatch = (old.postPatch or "") + lib.concatMapStrings (s: "${py.interpreter} ${s}\n") scripts;
    });

  # Combines the branch's 4 patches + bundling the host's Now Playing frontend.
  # Uses explicit overrideAttrs instead of mkPatched because cp (placing the frontend) is needed.
  ytmusicPatched = pkgs.mopidy-ytmusic.overrideAttrs (old: {
    postPatch =
      (old.postPatch or "")
      + "${py.interpreter} ${patchDir + "/ytdlp-patch.py"}\n" # switch stream resolution from pytube to yt-dlp
      + "${py.interpreter} ${patchDir + "/search-patch.py"}\n" # fix "any" search returning 0 results with album=None
      + "${py.interpreter} ${patchDir + "/home-patch.py"}\n" # add ytmusic:home (get_home) to browse
      + "${py.interpreter} ${patchDir + "/ytdistinct-patch.py"}\n" # enable get_distinct("album")
      + "${py.interpreter} ${patchDir + "/ytdistinctfilter-patch.py"}\n" # fix get_distinct("album") to filter by query's artist/albumartist/date (resolves duplicate display in list Album group AlbumArtist)
      + "${py.interpreter} ${patchDir + "/ytdistinctdate-patch.py"}\n" # fix bug where get_distinct() lacked a "date" branch so list date/count group date always returned 0 results (collect from get_library_albums() year, filter by artist/albumartist/album)
      + "${py.interpreter} ${patchDir + "/ytliked-patch.py"}\n" # fix crash on non-music items in Liked
      + "${py.interpreter} ${patchDir + "/ytartist-patch.py"}\n" # exclude spurious artist labels in search
      + "${py.interpreter} ${patchDir + "/ytimages-patch.py"}\n" # ensure track art for playlist/Liked
      + "${py.interpreter} ${patchDir + "/ytplaylistreorder-patch.py"}\n" # fix videoId truncation bug in save() + reflect track order
      + "${py.interpreter} ${patchDir + "/ytuploadfix-patch.py"}\n" # fix crash browsing Uploads (your own uploaded songs)
      + "${py.interpreter} ${patchDir + "/ytalbumfix-patch.py"}\n" # fix crash in albumToTracks (main path) with artists=None/missing trackCount
      + "${py.interpreter} ${patchDir + "/ythistory-patch.py"}\n" # fix bug where get_history() failed entirely on sections other than musicShelfRenderer
      + "${py.interpreter} ${patchDir + "/ytwatchemptypop-patch.py"}\n" # fix bug where res["tracks"].pop(0) in browse() ytmusic:watch branch raised IndexError on empty list
      + "${py.interpreter} ${patchDir + "/ytartistcache-patch.py"}\n" # fix bug where non-linked artists with id=None polluted the self.ARTISTS cache and shared names across different tracks
      + "${py.interpreter} ${patchDir + "/ytduration-patch.py"}\n" # fix bug where duration parsing truncated H:MM:SS (over 1 hour) + IndexError on colon-less duration strings
      + "${py.interpreter} ${patchDir + "/ytuploaddurationfix-patch.py"}\n" # fix hardcoded length=None in uploadArtistToTracks/uploadAlbumToTracks/parseSearch (artist branch) to actual length
      + "${py.interpreter} ${patchDir + "/ytartistalbumyear-patch.py"}\n" # fix bug where hardcoded "year" access in parseSearch (album/artist branches, 4 places total) dropped entire search results with KeyError
      + "${py.interpreter} ${patchDir + "/ytartistsongyear-patch.py"}\n" # fix bug where parseSearch (new album registration via songs in artist branch) used an unrelated hardcoded date="1999", changed to "0000" as elsewhere
      + "${py.interpreter} ${patchDir + "/ytartistnoexpand-patch.py"}\n" # fix bug where artistToTracks() returned 0 songs instead of falling back to songs['results'] when browseId (song-list expansion link) was missing
      + "${py.interpreter} ${patchDir + "/ytparsegaps-patch.py"}\n" # fix KeyError on missing artists key in parseSearch (song branch), get_artist_albums() failure in artist branch dragging songs down with it, and unguarded tracks=None in browse() artist branch
      + "${py.interpreter} ${patchDir + "/ytaudioformat-patch.py"}\n" # record samplerate/channels from yt-dlp resolution for status's audio field
      + "${py.interpreter} ${patchDir + "/ytsongformat-patch.py"}\n" # attach song uri to set_audio_format to feed the Format tag in song metadata
      + "${py.interpreter} ${patchDir + "/ytscrobble-patch.py"}\n" # guard scrobble_track() with try/except to prevent backend actor stalling on uncaught exceptions
      + "${py.interpreter} ${patchDir + "/ytcipherfail-patch.py"}\n" # guard update_cipher() with try/except to prevent permanent stall of the youtube_player_refresh timer thread on uncaught exceptions
      + "${py.interpreter} ${patchDir + "/ytapiactorrace-patch.py"}\n" # fix bug where on_start()'s RepeatingTimer (raw Thread) accessed self.api (ytmusicapi) directly and concurrently without going through the actor's message loop, racing with rmpc operations (actor thread) and potentially raising RuntimeError while iterating the shared self.api.headers dict (serialize onto the actor's own thread via proxy)
      + "${py.interpreter} ${patchDir + "/ytautoplaylistfix-patch.py"}\n" # fix bug where parse_auto_playlists() raised KeyError on title-less sections/items and TypeError on ctype=None concatenation, causing the entire "Auto Playlists" folder update to fail
      + "${py.interpreter} ${patchDir + "/yttopresultartist-patch.py"}\n" # fix bug where parseSearch()'s artist branch raised a secondary KeyError on Top result cards lacking browseId/artist (singular) keys, polluting logs and losing results
      + "${py.interpreter} ${patchDir + "/ytmoodgenre-patch.py"}\n" # fix bug where browse() ytmusic:mood:<params>:<browseId> hardcoded musicTwoRowItemRenderer and dropped categories mixing musicResponsiveListItemRenderer via KeyError
      + "${py.interpreter} ${patchDir + "/ytmoodcategory-patch.py"}\n" # fix bug where browse() ytmusic:mood (the category list itself) dragged everything down with KeyError/IndexError on section types other than gridRenderer or unexpected musicNavigationButtonRenderer structures, leaving the entire "Mood and Genre Playlists" folder empty
      + "${py.interpreter} ${patchDir + "/ytunavailabletrack-patch.py"}\n" # fix bug where playlistToTracks/uploadArtistToTracks/albumToTracks/uploadAlbumToTracks polluted the self.TRACKS cache with videoId=None (deleted/private/region-restricted songs), corrupting later unplayable songs too, plus KeyError where one song's unexpected data took down the whole call
      + "${py.interpreter} ${patchDir + "/ytplaylistdup-patch.py"}\n" # fix bug where save() dropped duplicate identical videoIds via set(), and _reorder_playlist() crashed with ValueError on duplicate videoIds
      + "${py.interpreter} ${patchDir + "/ytautoemptysection-patch.py"}\n" # fix off-by-one in _get_auto_playlists()'s empty-section removal loop (range(len(browse)-1,0,-1)) that never removed the first section (index 0)
      + "${py.interpreter} ${patchDir + "/ytstalecache-patch.py"}\n" # fix bug where playlistToTracks()/parseSearch() never overwrote the simple getTrack()-derived cache (album=None etc.)
      + "${py.interpreter} ${patchDir + "/ytalbumstale-patch.py"}\n" # fix bug where parseSearch()'s album branch and artist-path albums/singles branches (3 places total) never overwrote the existing 0000-placeholder ALBUMS cache with the real date
      + "${py.interpreter} ${patchDir + "/ytuploadartistlookup-patch.py"}\n" # fix bug where lookup()'s upload-artist branch wrongly called the dict-based artistToTracks() and always got 0 songs via AttributeError (changed to uploadArtistToTracks(), symmetric with browse())
      + "${py.interpreter} ${patchDir + "/ytuploadartistbrowselog-patch.py"}\n" # fix bug where browse()'s upload-artist branch accessed a nonexistent key 'artist' (correctly 'artists') in a debug log, swallowing tracks via KeyError and always browsing empty
      + "${py.interpreter} ${patchDir + "/ytsongalbumcache-patch.py"}\n" # fix bug where parseSearch()'s song branch never assigned to the album variable on ALBUMS cache hit, always ending up album=None
      + "${py.interpreter} ${patchDir + "/ytlookuptrackfail-patch.py"}\n" # fix bug where only lookup()'s single-song direct-URI-resolution branch lacked try/except around getTrack(), so get_song() failures for deleted/private/region-restricted songs were only logged as generic errors (symmetric with browse())
      + "${py.interpreter} ${patchDir + "/ytverifytrackurl-patch.py"}\n" # fix bug where the verify_track_url setting became dead config after ytdlp-patch.py's full rewrite of _get_track (restore the guard that HEAD-verifies the post-yt-dlp URL and treats 403 as playback failure)
      + "${py.interpreter} ${patchDir + "/ytsearchuri-patch.py"}\n" # fix bug where search()'s uri branch (MPD's find file/filename tag) only resolved album URIs and always returned 0 for artist/playlist/track URIs (unify by delegating to lookup())
      + "${py.interpreter} ${patchDir + "/ytsearchuriempty-patch.py"}\n" # fix bug where search()'s uri branch unconditionally accessed [0] on an empty query["uri"] list, raising IndexError (a LookupError subclass) that propagated uncaught via core.search()'s reraise=(TypeError, LookupError) (unify to returning None like out-of-scope URIs)
      + "${py.interpreter} ${patchDir + "/ytsearchgenre-patch.py"}\n" # fix bug where search() lacked a branch for query["genre"] (MPD's find/search/count genre tag) and always fell to the final else, returning 0 results (fall back to best-effort text search like the any branch)
      + "${py.interpreter} ${patchDir + "/ytsearchdate-patch.py"}\n" # fix bug where search() lacked a branch for query["date"] (MPD's find/search/count date tag, which find()'s own docstring officially expects) and always fell to the final else, returning 0 results (fall back to best-effort text search like the any/genre branches)
      + "${py.interpreter} ${patchDir + "/ytsearchtrack-patch.py"}\n" # fix bug where search() lacked a branch for query["track_no"] (MPD's find/search/count track tag) and always fell to the final else, returning 0 results (could not search despite real albumToTracks()-derived data; fall back to best-effort text search like the any/genre/date branches)
      + "${py.interpreter} ${patchDir + "/ytsearchmetatag-patch.py"}\n" # fix bug where search() lacked branches for query["composer"]/["performer"]/["comment"]/["disc_no"]/["musicbrainz_albumid"]/["musicbrainz_artistid"]/["musicbrainz_trackid"] (all officially mapped as MPD find/search/count tags) and always fell to the final else, returning 0 results (fall back to best-effort text search like the any/genre/date/track_no branches)
      + "${py.interpreter} ${patchDir + "/ytscrobblethreshold-patch.py"}\n" # fix bug where scrobble_fe.py's track_playback_ended() disabled the scrobble threshold check (50% played or 120s played) for songs with unknown duration (0) and scrobbled immediately
      + "${py.interpreter} ${patchDir + "/ytartistsongsvideoid-patch.py"}\n" # fix bug where parseSearch()'s artist branch (get_artist songs loop) polluted the self.TRACKS cache with videoId=None (unplayable songs) (extend the same fix as ytunavailabletrack-patch.py for playlistToTracks etc.)
      + "${py.interpreter} ${patchDir + "/ytalbumidcache-patch.py"}\n" # fix bug where non-linked albums with id=None polluted the self.ALBUMS cache and shared album names across unrelated tracks (extend the same class of bug as ytartistcache-patch.py's self.ARTISTS fix to self.ALBUMS, in 4 places: playlistToTracks/uploadArtistToTracks/parseSearch song- and artist-path songs)
      + "${py.interpreter} ${patchDir + "/ytalbumtrackartist-patch.py"}\n" # fix bug where albumToTracks() always fell to the else branch due to a type mismatch comparing song["artists"] (list) == artistname (str), losing per-song artist info and uri every time (unify to the same per-track artist assembly as playlistToTracks())
      + "${py.interpreter} ${patchDir + "/ytoauthplaylistguard-patch.py"}\n" # fix bug where __init__()'s self.playlists assignment checked only self.auth and not self.oauth, so with only oauth_json configured the entire YouTube Music playlist feature (has_playlists()=False) disappeared for no apparent reason
      + "${py.interpreter} ${patchDir + "/ytoauthlibraryguard-patch.py"}\n" # fix bug where 4 places in library.py's browse() (root/artist/album/watch) checked only self.auth and not self.oauth, so with only oauth_json configured the main browse directories like Home/Artists/Albums disappeared for no apparent reason (extend the same class of bug as ytoauthplaylistguard-patch.py to library.py)
      + "${py.interpreter} ${patchDir + "/ytuploadalbumlookup-patch.py"}\n" # fix bug where lookup()'s upload-album branch wrongly called albumToTracks() (non-upload only), causing missing :upload on Album/Artist URIs and 0-song results (changed to uploadAlbumToTracks(), symmetric with browse())
      + "${py.interpreter} ${patchDir + "/ytaddresultcheck-patch.py"}\n" # fix silent data loss where save() never checked add_playlist_items()'s return value (whether "status" contains SUCCEEDED), always treating it as success, so on failure (e.g. duplicate videoId rejection) currentOrder/setVideoIdByVideoId got polluted on the assumption the add succeeded
      + "${py.interpreter} ${patchDir + "/ytcreateplaylistcheck-patch.py"}\n" # fix bug where create() only truthy-checked create_playlist()'s return value and mistook the raw response dict returned on failure (non-empty, always truthy) for a playlistId string, returning a "looks-created" Playlist with a broken URI embedding bId (same class as ytaddresultcheck-patch.py's add side; the create-side follow-up left in its verified comment)
      + "${py.interpreter} ${patchDir + "/ytremoveresultcheck-patch.py"}\n" # fix silent data inconsistency where save() never checked remove_playlist_items()'s return value, always treating it as success, so even when YouTube Music's removal failed (e.g. concurrent-edit conflict) it removed the entry from setVideoIdByVideoId (a song that should be gone keeps appearing in listplaylistinfo) (the remove side paired with ytaddresultcheck-patch.py's add side; differs in that the success-check type is str/dict)
      + "${py.interpreter} ${patchDir + "/ytplaylisteditcheck-patch.py"}\n" # fix bug where save() never checked edit_playlist()'s (rename/moveItem reorder) return value, always treating it as success. In particular the reorder side, on failure, updates internal tracking state "working" and breaks the assumptions of subsequent moveItem computations, chaining failures, so return and abort immediately as on an exception
      + "${py.interpreter} ${patchDir + "/ytdeleteplaylistcheck-patch.py"}\n" # fix bug where delete() never checked delete_playlist()'s return value and always treated no-exception as success (True). Since mopidy_mpd's rm command returns OK based on this True, even when deletion actually failed on YTM, clients like rmpc see it as a successful delete and the playlist reappears on the next sync — a silent inconsistency (same class as the create/remove/edit return-value-unchecked bugs; the last remaining delete-side follow-up in playlist.py)
      + "${py.interpreter} ${patchDir + "/ytlibrarylimit-patch.py"}\n" # fix bug where browse()'s artist/album branches (normal + upload, 4 places total) and as_list()'s get_library_playlists() called with a hardcoded limit=100 even though ytmusicapi supports fetching everything (continuation) with limit=None, so on accounts exceeding 100 followed/100 saved albums/100 saved playlists/100 uploads, entries past the 100th silently vanished with no error or log (get_distinct() already used the config-variable playlist_item_limit; only browse/as_list were asymmetric)
      + "${py.interpreter} ${patchDir + "/ytdistinctlimit-patch.py"}\n" # fix bug where get_distinct() (enumeration of library-registered artists/albums/years used by list/count group/stats, 3 places total) called get_library_artists/get_library_albums() with a hardcoded config-variable playlist_item_limit (default 100), so even after ytlibrarylimit-patch.py fixed browse() to fetch everything (limit=None), only get_distinct() still silently truncated entries past the 100th with no error or log (resolves the asymmetry where lsinfo returns everything but list album/count group album/stats albums: are capped)
      + "${py.interpreter} ${patchDir + "/ytthumbnailguard-patch.py"}\n" # fix bug where addThumbnails() fetched thumbnail elements' width/height by direct index, raising KeyError on thumbnails missing width/height, and via unguarded calls at the tail of albumToTracks()/getTrack() lost already-completed track lists/Track objects entirely (switch to .get() + isolate callers with try/except)
      + "${py.interpreter} ${patchDir + "/ytplaylistunavailableguard-patch.py"}\n" # fix bug where save() built oldCounts/removeCounts from the raw response pls["tracks"] (including unplayable songs) while newOrder was built from playlistToTracks()-filtered playlist.tracks, so unplayable songs (falsy videoId) were mistaken for user-removed songs and actually deleted from the real playlist by any MPD command going through save() (playlistadd/rm/rename etc.) (align diff computation & removal-candidate enumeration to availableTracks)
      + "${py.interpreter} ${patchDir + "/ytlivestream-patch.py"}\n" # fix bug where YTMusicPlaybackProvider never overrode mopidy.backend.PlaybackProvider's is_live() and was always fixed False, so a currently-streaming live video was passed to GStreamer as a finite-length file (record the actual live determination from yt-dlp's info['is_live']/['live_status'] and reflect it in is_live())
      + "${py.interpreter} ${patchDir + "/ytaudioformatstale-patch.py"}\n" # fix bug where _get_track() skipped the set_audio_format() call itself for songs where asr/audio_channels couldn't be obtained (e.g. HLS-family formats of live streams), so status's audio field indefinitely retained the previous song's samplerate/channels (always call set_audio_format with the new song's uri, using None when values are unknown)
      + "${py.interpreter} ${patchDir + "/ytfindalbumtracks-patch.py"}\n" # fix bug where search()'s album branch, via parseSearch(), only accumulated SearchResult.albums (browse placeholders) and returned no real tracks, so find album "X" stayed OK but always returned 0 even when a matching album existed (expand real tracks with albumToTracks() and add them). Also resolves the issue where, when both album/artist tags are given, the artist branch (filter="artists") took priority and the album name was never used in the backend search, by reordering to evaluate the album branch before artist
      + "${py.interpreter} ${patchDir + "/ytlibrarycachecap-patch.py"}\n" # fix bug where self.TRACKS/ALBUMS/ARTISTS/IMAGES (videoId/browseId-keyed library caches) remained unbounded dicts written from 50+ places like getTrack()/playlistToTracks()/albumToTracks()/parseSearch(), so as a long-running resident service memory grew monotonically with browsing/searching (replace with a dict-inheriting _BoundedLibraryCache in the same spirit as _MPDART_CACHE/_audio_format_cache, discarding in insertion order (FIFO) past 8192 entries each. References to evicted entries are just cache misses and re-fetched, never exceptions)
      + "${py.interpreter} ${patchDir + "/ytsearchthumbnail-patch.py"}\n" # fix bug where parseSearch()'s song branch/artist-branch songs sub-loop never cached track["thumbnails"] already present in the response into self.IMAGES, so songs first touched via search (search/find) always failed albumart/readpicture (extend the same approach ytimages-patch.py introduced for playlistToTracks() to the 2 places in parseSearch(), no extra API calls)
      + "${py.interpreter} ${patchDir + "/ytsearchalbumidcache-patch.py"}\n" # fix bug where parseSearch()'s resultType=="album" branch (case where a search result is directly an album) used browseId (which can actually be None since ytmusicapi fetches it with none_if_absent=True) as the self.ALBUMS cache key & URI suffix with no missing-value check (the id=None guard ytalbumidcache-patch.py already extended to 4 places (playlistToTracks/uploadArtistToTracks/parseSearch song- and artist-path songs) was missing from just this one place. When browseId is missing, don't cache and return an ephemeral Album with uri="")
      + "${py.interpreter} ${patchDir + "/ytlastidrace-patch.py"}\n" # fix bug where YTMusicPlaybackProvider.last_id (used as the seed song by browse()'s ytmusic:watch branch = "Similar to last played") was overwritten by the next song's value during the gapless prefetch/play() async-promotion wait window, so while status/currentsong correctly reported current song A, only ytmusic:watch returned recommendations based on next song B (a missed extension of the same call path as mpdaudioformatpreload-patch.py. Mixin the same AudioListener.stream_changed event into YTMusicBackend that mopidy core itself uses to promote _current_tl_track, and only finalize last_id on the song that actually started playing)
      + "${py.interpreter} ${patchDir + "/ytplaylistlookupid-patch.py"}\n" # fix bug where lookup() built the returned Playlist.uri from the response's pls["id"] rather than the requested id (bId), so for non-owned playlists (created by others and merely saved to the library) pls["id"] is not the real playlist ID but a different watch-playlist ID (can be None/a different ID), causing all save()-based edit operations from rmpc etc. (playlistadd/rename/reorder) to be silently ignored or misdirected at an unrelated target (unify to the same "requested id" basis as as_list()/save())
      + "${py.interpreter} ${patchDir + "/ytsearchsongartist-patch.py"}\n" # fix bug where parseSearch()'s song branch, via rmpc's default-tag search any/find any (filter=None, ytmusicapi's "top result" shape), had artists consisting only of resultType-mislabeled dummies that became empty after exclusion, so Artist/AlbumArtist were always dropped entirely in rmpc's normal search (only when artists is empty after exclusion, supplement real artist names via getTrack()'s api.get_song() fallback)
      + "${py.interpreter} ${patchDir + "/ytartistfilterlist-patch.py"}\n" # fix bug where get_distinct()'s field=="artist"/"albumartist" branches returned all library artists without looking at the query at all. Even the basic example `list "artist" "artist" "ABBA"` (should list only ABBA) from the MPD-protocol official spec's own list_() docstring didn't work; the album/date branches (ytdistinctfilter-patch.py/ytdistinctdate-patch.py) already supported query filtering, so resolve the asymmetry where only artist/albumartist branches were left behind (equality-filter by the values of query's artist/albumartist keys)
      + "${py.interpreter} ${patchDir + "/ytbitrate-patch.py"}\n" # fix bug where _get_track() never referenced/propagated the measured bitrate (abr) from yt-dlp resolution, so combined with mopidy_ytmusic's hardcoded Track.bitrate=0, status's bitrate field always returned 0 even during actual playback (write to mpd-patch.py's (mpdbitrate-patch.py) uri-keyed cache in the same spirit as ytaudioformat-patch.py)
      + "${py.interpreter} ${patchDir + "/ytuploadalbumtrackno-patch.py"}\n" # fix bug where uploadAlbumToTracks() (Uploads album browse) unconditionally set track_no to None, and since mopidy_mpd/translator.py doesn't output the Track tag at all for songs with track_no is None, only Uploads-path albums always lost the Track line in find/search/lsinfo/playlistinfo/currentsong responses (set real track numbers with the same enumerate(start=1) technique as its sibling function albumToTracks())
      + "${py.interpreter} ${patchDir + "/ytsearchvideoresult-patch.py"}\n" # fix bug where parseSearch()'s if/elif chain handled only resultType "song"/"album"/"artist" and silently passed through & discarded resultType "video" (frequent in ytmusicapi search results; parses videoId/artists/duration via parse_song_runs() shared across song/video/album, nearly identical structure to song). When official music videos of popular songs dominate unfiltered YouTube Music search, results of search any/find any (rmpc's search UI actually issues this any search) are occupied only by resultType "video" and no matching song/album remains, so a song that exists and is playable (findable via filter-narrowed searches like search title) becomes undiscoverable via the main any-search path — resolve this inconsistent content loss by duplicating the song-branch logic to also pick up resultType "video" as Track
      + "${py.interpreter} ${patchDir + "/ytsearchepisoderesult-patch.py"}\n" # fix a same-class hole remaining for another resultType: parseSearch()'s if/elif chain had no branch for resultType "episode" (individual podcast episodes, immediately playable with a real videoId) and silently passed through & discarded it. Unlike video, episode has no artists/duration but instead has the podcast (show) id/name info, so use the show name as a name-only Artist with no uri (registering the show browseId as a ytmusic:artist: URI would lead to wrong browse results in rmpc), and leave album/duration to the existing safe placeholder/fallback, picking it up as Track
      + "${py.interpreter} ${patchDir + "/ytsearchstationresult-patch.py"}\n" # fix a same-class hole (like ytsearchvideoresult-patch.py/ytsearchepisoderesult-patch.py) remaining for another resultType: parseSearch()'s if/elif chain had no branch for resultType "station" (radio/mix stations, immediately playable with a real videoId seed song) and silently passed through & discarded it. station has no artists/duration, so pick it up as Track with empty/fallback values
      + "${py.interpreter} ${patchDir + "/ytviewsartist-patch.py"}\n" # fix bug where playlistToTracks() turned every entry of a track's artists list into an Artist unconditionally, while some ytmusicapi parsers (parse_artists_runs, used by get_history() via parse_playlist_items) classify no run types and hand back view counts ("40K views") and item-type words as id-less artists, so Recently Played tracks got a bogus second artist that leaked into rmpc's artist column, search results and list Artist (concentrate the decision in one _yt_is_junk_artist() helper and route parseSearch()'s existing item-type-only exclusion through it too)
      + "${py.interpreter} ${patchDir + "/ythomemeta-patch.py"}\n" # fix bug where the ytmusic:home browse added by home-patch.py only returned Refs without warming TRACKS, so the lookup() that mopidy-mpd issues right after fell through to getTrack() -> get_song() and took its metadata from videoDetails, i.e. the YouTube video's own title and channel name instead of the YouTube Music song's ("今日の日はさようなら - Kyo no Hi wa Sayonara" collapsing to "Kyo no Hi wa Sayonara"), also dropping the album — every song under Home showed a romanized title in rmpc (cache get_home()'s metadata via the existing playlistToTracks(), marking the entries length=None since get_home() carries no duration, and have getTrack() fill just the length from videoDetails once so Time/duration does not regress to 0)
      + "${py.interpreter} ${patchDir + "/ytrangeheader-patch.py"}\n" # fix bug where playback took ~17s to start and some playable songs were dropped as unplayable: googlevideo now answers a plain rangeless GET with 403 or throttles it to 8-30 KiB/s (measured 2026-08-16; the same URL with "Range: bytes=0-" streams at 5-14 MiB/s), yet GStreamer's souphttpsrc issues exactly such a GET for its first request and verify_track_url's HEAD did too (set the Range plus yt-dlp's own request headers on the source element via PlaybackProvider.on_source_setup and on the HEAD; change_track() is a copy of mopidy's old implementation and never called set_source_setup_callback(), without which the hook never fires, so add that call as well)
