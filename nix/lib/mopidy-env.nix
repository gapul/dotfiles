py.withPackages (
  ps:
  (map toM [
    pkgs.mopidy
    ytmusicPatched
    mpdPatched
    listenbrainzPatched
  ])
  ++ [
    ps.yt-dlp
    ps.pyobjc-core # because nowplaying_fe hits MediaPlayer.framework
    ps.pyobjc-framework-Cocoa
  ]
)
