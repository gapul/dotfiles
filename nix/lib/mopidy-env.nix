  listenbrainzPatched = mkPatched pkgs.mopidy-listenbrainz [
    (patchDir + "/lb-patch.py") # fix the 400 on sending an empty release_name
    (patchDir + "/lbplaylistguard-patch.py") # fix bug where only list_playlists_created_for_user() lacked check_response_status()'s try/except guard, so when the ListenBrainz API temporarily returns non-200 (401/429/5xx etc.) the whole actor crashes (via on_start) or the weekly re-import permanently stalls (via Timer)
