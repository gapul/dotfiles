# Mopidy 実行環境 (本体 + 拡張 + yt-dlp を単一 site-packages に束ねた python env)。
# 宣言モジュール home/mopidy.nix と、macmini の自走テスト鏡の両方から import して
# 同一定義を共有する (パッチ適用のドリフト防止)。
#
# nixpkgs 素の mopidy-ytmusic / mopidy-mpd / mopidy-listenbrainz は現行 YouTube/rmpc に
# 対し不足があるため、configs/media/mopidy/*.py のビルド時パッチを焼き込む。
# 新しいパッチを足したら、対象拡張の patch リストに追記するだけでよい。
{ pkgs }:
let
  inherit (pkgs) lib;
  py = pkgs.python3;
  toM = py.pkgs.toPythonModule;
  patchDir = ../../configs/media/mopidy;

  # 拡張に postPatch として python パッチ群を順に当てる
  mkPatched =
    pkg: scripts:
    pkg.overrideAttrs (old: {
      postPatch = (old.postPatch or "") + lib.concatMapStrings (s: "${py.interpreter} ${s}\n") scripts;
    });

  # ブランチの4パッチ + 母艦の Now Playing フロントエンド同梱を統合。
  # cp(フロントエンド配置)が必要なため mkPatched でなく overrideAttrs で明示。
  ytmusicPatched = pkgs.mopidy-ytmusic.overrideAttrs (old: {
    postPatch =
      (old.postPatch or "")
      + "${py.interpreter} ${patchDir + "/ytdlp-patch.py"}\n" # ストリーム解決を pytube→yt-dlp へ
      + "${py.interpreter} ${patchDir + "/search-patch.py"}\n" # any 検索が album=None で0件を是正
      + "${py.interpreter} ${patchDir + "/home-patch.py"}\n" # ブラウズに ytmusic:home (get_home)
      + "${py.interpreter} ${patchDir + "/ytdistinct-patch.py"}\n" # get_distinct("album") 有効化
      + "${py.interpreter} ${patchDir + "/ytdistinctfilter-patch.py"}\n" # get_distinct("album") がqueryのartist/albumartist/dateで絞り込むよう修正 (list Album group AlbumArtistの重複表示を解消)
      + "${py.interpreter} ${patchDir + "/ytdistinctdate-patch.py"}\n" # get_distinct()が"date"分岐を持たずlist date/count group dateが常に0件になる不具合を修正 (get_library_albums()のyearから収集、artist/albumartist/albumで絞り込み)
      + "${py.interpreter} ${patchDir + "/ytliked-patch.py"}\n" # Liked の非音楽アイテムのクラッシュ修正
      + "${py.interpreter} ${patchDir + "/ytartist-patch.py"}\n" # 検索の誤爆アーティスト表記を除外
      + "${py.interpreter} ${patchDir + "/ytimages-patch.py"}\n" # プレイリスト/Liked のトラックart確実化
      + "${py.interpreter} ${patchDir + "/ytplaylistreorder-patch.py"}\n" # save()のvideoId truncationバグ修正+曲順反映
      + "${py.interpreter} ${patchDir + "/ytuploadfix-patch.py"}\n" # Uploads(自分のアップロード曲)ブラウズのクラッシュ修正
      + "${py.interpreter} ${patchDir + "/ytalbumfix-patch.py"}\n" # albumToTracks(主経路)がartists=None/trackCount欠落でクラッシュする不具合を修正
      + "${py.interpreter} ${patchDir + "/ythistory-patch.py"}\n" # get_history()がmusicShelfRenderer以外のセクションで丸ごと失敗する不具合を修正
      + "${py.interpreter} ${patchDir + "/ytwatchemptypop-patch.py"}\n" # browse() ytmusic:watch分岐のres["tracks"].pop(0)が空リストでIndexErrorを送出する不具合を修正
      + "${py.interpreter} ${patchDir + "/ytartistcache-patch.py"}\n" # id=Noneの非リンクアーティストがself.ARTISTSキャッシュを汚染し別トラックの名前を共有してしまう不具合を修正
      + "${py.interpreter} ${patchDir + "/ytduration-patch.py"}\n" # 曲長パースがH:MM:SS(1時間超)を切り捨てる不具合+コロン無しduration文字列でのIndexErrorを修正
      + "${py.interpreter} ${patchDir + "/ytuploaddurationfix-patch.py"}\n" # uploadArtistToTracks/uploadAlbumToTracks/parseSearch(artist分岐)のlength=None決め打ちを実長さへ修正
      + "${py.interpreter} ${patchDir + "/ytartistalbumyear-patch.py"}\n" # parseSearch(album/artist分岐計4箇所)の"year"決め打ちアクセスがKeyErrorでsearch結果を丸ごと欠落させる不具合を修正
      + "${py.interpreter} ${patchDir + "/ytartistsongyear-patch.py"}\n" # parseSearch(artist分岐のsongs経由album新規登録)が無関係なdate="1999"決め打ちを使う不具合を他箇所と同じ"0000"へ修正
      + "${py.interpreter} ${patchDir + "/ytartistnoexpand-patch.py"}\n" # artistToTracks()がbrowseId(曲一覧展開リンク)欠落時にsongs['results']へフォールバックせず曲を丸ごと0件にしていた不具合を修正
      + "${py.interpreter} ${patchDir + "/ytparsegaps-patch.py"}\n" # parseSearch(song分岐)のartistsキー欠落KeyError・artist分岐のget_artist_albums()失敗がsongsまで道連れにする不具合・browse()artist分岐のtracks=None未ガードを修正
      + "${py.interpreter} ${patchDir + "/ytaudioformat-patch.py"}\n" # yt-dlp解決結果のsamplerate/channelsをstatusのaudioフィールド用に記録
      + "${py.interpreter} ${patchDir + "/ytsongformat-patch.py"}\n" # set_audio_format に曲uriを付与し曲メタデータのFormatタグへ供給
      + "${py.interpreter} ${patchDir + "/ytscrobble-patch.py"}\n" # scrobble_track()を try/except で保護し未捕捉例外によるバックエンドアクター停止を防止
      + "${py.interpreter} ${patchDir + "/ytcipherfail-patch.py"}\n" # update_cipher()を try/except で保護し未捕捉例外によるyoutube_player_refreshタイマースレッドの永久停止を防止
      + "${py.interpreter} ${patchDir + "/ytapiactorrace-patch.py"}\n" # on_start()のRepeatingTimer(素のThread)がactorのメッセージループを経由せずself.api(ytmusicapi)へ直接並行アクセスし、rmpc操作(actorスレッド)と競合してself.api.headers共有dictの走査中にRuntimeErrorが起きうる不具合を修正 (proxy経由でactor自身のスレッドへ直列化)
      + "${py.interpreter} ${patchDir + "/ytautoplaylistfix-patch.py"}\n" # parse_auto_playlists()がタイトル欠落セクション/アイテムでKeyError、ctype=None結合でTypeErrorとなり「Auto Playlists」フォルダ全体の更新が丸ごと失敗する不具合を修正
      + "${py.interpreter} ${patchDir + "/yttopresultartist-patch.py"}\n" # parseSearch()のartist分岐がbrowseId/artist(単数)キーを持たないTop resultカードで二次的なKeyErrorを起こしログを汚したまま結果を失う不具合を修正
      + "${py.interpreter} ${patchDir + "/ytmoodgenre-patch.py"}\n" # browse() ytmusic:mood:<params>:<browseId> がmusicTwoRowItemRenderer決め打ちでmusicResponsiveListItemRenderer混在カテゴリをKeyErrorで丸ごと欠落させる不具合を修正
      + "${py.interpreter} ${patchDir + "/ytmoodcategory-patch.py"}\n" # browse() ytmusic:mood (カテゴリ一覧自体) がgridRenderer以外のセクション種別やmusicNavigationButtonRendererの想定外構造をKeyError/IndexErrorで丸ごと道連れにし「Mood and Genre Playlists」フォルダ全体が空になる不具合を修正
      + "${py.interpreter} ${patchDir + "/ytunavailabletrack-patch.py"}\n" # playlistToTracks/uploadArtistToTracks/albumToTracks/uploadAlbumToTracksがvideoId=None(削除/非公開/地域制限曲)をself.TRACKSキャッシュへ汚染混入させ以後の別の再生不能曲まで化けさせる不具合と、1曲の想定外データが呼び出し全体を巻き込むKeyErrorを修正
      + "${py.interpreter} ${patchDir + "/ytplaylistdup-patch.py"}\n" # save()が同一videoIdの重複を set() で潰して欠落させる不具合と、_reorder_playlist()が重複videoIdでValueErrorクラッシュする不具合を修正
      + "${py.interpreter} ${patchDir + "/ytautoemptysection-patch.py"}\n" # _get_auto_playlists()の空セクション削除ループがrange(len(browse)-1,0,-1)というオフバイワンで先頭セクション(index 0)を決して削除しない不具合を修正
      + "${py.interpreter} ${patchDir + "/ytstalecache-patch.py"}\n" # playlistToTracks()/parseSearch()がgetTrack()由来の簡易キャッシュ(album=None等)を二度と上書きしない不具合を修正
      + "${py.interpreter} ${patchDir + "/ytalbumstale-patch.py"}\n" # parseSearch()のalbum分岐/artist経由albums・singles分岐(計3箇所)が実dateで既存の0000プレースホルダALBUMSキャッシュを上書きしない不具合を修正
      + "${py.interpreter} ${patchDir + "/ytuploadartistlookup-patch.py"}\n" # lookup()のアップロードアーティスト分岐がdict前提のartistToTracks()を誤って呼びAttributeErrorで常に0曲になる不具合を修正 (uploadArtistToTracks()に変更、browse()と対称化)
      + "${py.interpreter} ${patchDir + "/ytuploadartistbrowselog-patch.py"}\n" # browse()のアップロードアーティスト分岐がデバッグログで存在しないキー'artist'(正しくは'artists')にアクセスしKeyErrorでtracksを握り潰し常に空ブラウズになる不具合を修正
      + "${py.interpreter} ${patchDir + "/ytsongalbumcache-patch.py"}\n" # parseSearch()のsong分岐がALBUMSキャッシュヒット時にalbum変数へ代入されず常にalbum=Noneになる不具合を修正
      + "${py.interpreter} ${patchDir + "/ytlookuptrackfail-patch.py"}\n" # lookup()の単曲URI直接解決分岐だけgetTrack()呼び出しがtry/exceptによる保護を欠き、削除/非公開/地域制限曲のget_song()失敗が汎用エラーとしてしか記録されない不具合を修正 (browse()と対称化)
      + "${py.interpreter} ${patchDir + "/ytverifytrackurl-patch.py"}\n" # verify_track_url設定がytdlp-patch.pyの_get_track全面書き換えで死に設定化していた不具合を修正 (yt-dlp解決後URLをHEADで実検証し403なら再生失敗として扱うガードを復元)
      + "${py.interpreter} ${patchDir + "/ytsearchuri-patch.py"}\n" # search()のuri分岐(MPDのfind file/filenameタグ)がalbum URIしか解決せずartist/playlist/track URIで常に0件になる不具合を修正 (lookup()への委譲に統一)
      + "${py.interpreter} ${patchDir + "/ytsearchuriempty-patch.py"}\n" # search()のuri分岐がquery["uri"]空リストで無条件[0]アクセスしIndexError(LookupErrorのサブクラス)を送出、core.search()のreraise=(TypeError, LookupError)により未捕捉のまま伝播する不具合を修正 (対象外URIと同じNone返却に統一)
      + "${py.interpreter} ${patchDir + "/ytsearchgenre-patch.py"}\n" # search()がquery["genre"](MPDのfind/search/count genreタグ)を扱う分岐を持たず常に最終elseへ落ちて0件になる不具合を修正 (any分岐と同じベストエフォートのテキスト検索へフォールバック)
      + "${py.interpreter} ${patchDir + "/ytsearchdate-patch.py"}\n" # search()がquery["date"](MPDのfind/search/count dateタグ。find()自身のdocstringが公式に想定すると明記)を扱う分岐を持たず常に最終elseへ落ちて0件になる不具合を修正 (any/genre分岐と同じベストエフォートのテキスト検索へフォールバック)
      + "${py.interpreter} ${patchDir + "/ytsearchtrack-patch.py"}\n" # search()がquery["track_no"](MPDのfind/search/count trackタグ)を扱う分岐を持たず常に最終elseへ落ちて0件になる不具合を修正 (albumToTracks()由来の実データがあるにも関わらず検索できなかった。any/genre/date分岐と同じベストエフォートのテキスト検索へフォールバック)
      + "${py.interpreter} ${patchDir + "/ytsearchmetatag-patch.py"}\n" # search()がquery["composer"]/["performer"]/["comment"]/["disc_no"]/["musicbrainz_albumid"]/["musicbrainz_artistid"]/["musicbrainz_trackid"](いずれもMPDのfind/search/countタグとして正式にマップ済み)を扱う分岐を持たず常に最終elseへ落ちて0件になる不具合を修正 (any/genre/date/track_no分岐と同じベストエフォートのテキスト検索へフォールバック)
      + "${py.interpreter} ${patchDir + "/ytscrobblethreshold-patch.py"}\n" # scrobble_fe.pyのtrack_playback_ended()がduration不明(0)の曲でscrobble閾値判定(50%再生 or 120秒再生)を無効化し即scrobbleしてしまう不具合を修正
      + "${py.interpreter} ${patchDir + "/ytartistsongsvideoid-patch.py"}\n" # parseSearch()のartist分岐(get_artist songsループ)がvideoId=None(再生不能曲)をself.TRACKSキャッシュへ汚染混入させる不具合を修正 (playlistToTracks等ytunavailabletrack-patch.pyと同じ対策を横展開)
      + "${py.interpreter} ${patchDir + "/ytalbumidcache-patch.py"}\n" # id=Noneの非リンクアルバムがself.ALBUMSキャッシュを汚染し無関係な別トラックのアルバム名を共有してしまう不具合を修正 (ytartistcache-patch.pyのself.ARTISTS対策と同型のバグをself.ALBUMSにも横展開、playlistToTracks/uploadArtistToTracks/parseSearch song・artist経由songsの4箇所)
      + "${py.interpreter} ${patchDir + "/ytalbumtrackartist-patch.py"}\n" # albumToTracks()がsong["artists"](list)とartistname(str)を==比較する型不一致により常にelse分岐へ落ち、曲固有アーティスト情報とuriを毎回失っていた不具合を修正 (playlistToTracks()と同じper-track artist組み立てに統一)
      + "${py.interpreter} ${patchDir + "/ytoauthplaylistguard-patch.py"}\n" # __init__()のself.playlists代入がself.authのみを見てself.oauthを見ておらずoauth_jsonのみ設定時にYouTube Musicプレイリスト機能全体(has_playlists()=False)が理由不明で消える不具合を修正
      + "${py.interpreter} ${patchDir + "/ytoauthlibraryguard-patch.py"}\n" # library.pyのbrowse()の4箇所(root/artist/album/watch)がself.authのみを見てself.oauthを見ておらずoauth_jsonのみ設定時にHome/Artists/Albums等の主要ブラウズディレクトリが理由不明で消える不具合を修正 (ytoauthplaylistguard-patch.pyと同型のバグをlibrary.pyへ横展開)
      + "${py.interpreter} ${patchDir + "/ytuploadalbumlookup-patch.py"}\n" # lookup()のアップロードアルバム分岐がalbumToTracks()(非アップロード専用)を誤って呼びAlbum/Artist URIの:upload欠落・0曲判定を招く不具合を修正 (uploadAlbumToTracks()に変更、browse()と対称化)
      + "${py.interpreter} ${patchDir + "/ytaddresultcheck-patch.py"}\n" # save()がadd_playlist_items()の戻り値("status"にSUCCEEDEDを含むか)を一切確認せず常に成功扱いし、重複videoId拒否等の失敗時にcurrentOrder/setVideoIdByVideoIdが「追加成功した」前提で汚染されるサイレントなデータ欠落を修正
      + "${py.interpreter} ${patchDir + "/ytcreateplaylistcheck-patch.py"}\n" # create()がcreate_playlist()の戻り値をtruthy判定のみで確認し、失敗時に返る生レスポンスdict(非空で常にtruthy)をplaylistId文字列と誤認してbId埋め込みの壊れたURIを持つ「作成成功したように見える」Playlistを返してしまう不具合を修正 (ytaddresultcheck-patch.pyのadd側と同型、そのverifiedコメントで残されていたcreate側のフォローアップ)
      + "${py.interpreter} ${patchDir + "/ytremoveresultcheck-patch.py"}\n" # save()がremove_playlist_items()の戻り値を一切確認せず常に成功扱いし、並行編集競合等でYouTube Music側の削除が失敗してもsetVideoIdByVideoIdから該当エントリを消してしまう(listplaylistinfoで消えたはずの曲が残り続ける)サイレントなデータ不整合を修正 (ytaddresultcheck-patch.pyのadd側と対をなすremove側、成功判定の型がstr/dictで異なる点が相違)
      + "${py.interpreter} ${patchDir + "/ytplaylisteditcheck-patch.py"}\n" # save()がedit_playlist()(リネーム/moveItem並べ替え)の戻り値を一切確認せず常に成功扱いする不具合を修正。特に並べ替え側は失敗しても内部追跡状態working更新→後続moveItemの計算前提が壊れ失敗が連鎖しうるため、例外時と同様に直ちにreturnして中断する
      + "${py.interpreter} ${patchDir + "/ytdeleteplaylistcheck-patch.py"}\n" # delete()がdelete_playlist()の戻り値を一切確認せず例外が出なければ常に成功(True)扱いする不具合を修正。mopidy_mpdのrmコマンドはこのTrueを見てOKを返すため、YTM側で実際には削除が失敗していてもrmpc等のクライアントからは削除成功したように見え次回同期でプレイリストが復活するサイレントな不整合になる (create/remove/edit側の一連の戻り値未検証バグと同型、playlist.py内で最後に残っていたdelete側のフォローアップ)
      + "${py.interpreter} ${patchDir + "/ytlibrarylimit-patch.py"}\n" # browse()のartist/album分岐(通常+アップロード計4箇所)とas_list()のget_library_playlists()が、ytmusicapiがlimit=Noneで全件取得(continuation)に対応しているにも関わらずlimit=100固定で呼んでおり、フォロー100組/保存100枚/保存100個/アップロード100件を超えるアカウントで101件目以降がエラーもログも無く静かに消える不具合を修正 (get_distinct()側は既にconfig可変のplaylist_item_limitを使っておりbrowse/as_list側だけ非対称だった)
      + "${py.interpreter} ${patchDir + "/ytdistinctlimit-patch.py"}\n" # get_distinct()(list/count group/statsが経由するライブラリ登録アーティスト/アルバム/年の列挙、計3箇所)がget_library_artists/get_library_albums()をconfig可変のplaylist_item_limit(既定100)固定で呼んでおり、ytlibrarylimit-patch.pyがbrowse()側を全件取得(limit=None)へ直した後もget_distinct()側だけ101件目以降をエラーもログも無く静かに切り捨てる不具合を修正 (lsinfoは全件返るのにlist album/count group album/statsのalbums:だけ頭打ちになる非対称を解消)
      + "${py.interpreter} ${patchDir + "/ytthumbnailguard-patch.py"}\n" # addThumbnails()がサムネイル要素のwidth/heightを直接インデックスで取得しておりwidth/height欠落サムネイルでKeyErrorを送出、無防備なalbumToTracks()/getTrack()末尾からの呼び出しにより既に完成していたトラック一覧/Trackオブジェクトごと失われる不具合を修正 (.get()化+呼び出し元をtry/exceptで隔離)
      + "${py.interpreter} ${patchDir + "/ytplaylistunavailableguard-patch.py"}\n" # save()がoldCounts/removeCountsを生レスポンスpls["tracks"](再生不能曲込み)から作る一方、newOrderはplaylistToTracks()でフィルタ済みのplaylist.tracksから作るため、再生不能曲(videoId偽値)をユーザーが取り除いた曲と誤認しplaylistadd/rm/rename等save()を経由するあらゆるMPDコマンドで実プレイリストから実際に削除してしまう不具合を修正 (差分計算・削除候補列挙をavailableTracksに揃える)
      + "${py.interpreter} ${patchDir + "/ytlivestream-patch.py"}\n" # YTMusicPlaybackProviderがmopidy.backend.PlaybackProviderのis_live()を一切オーバーライドせず常にFalse固定になっており、現在配信中のライブ動画もGStreamerへ有限長ファイルとして渡されてしまう不具合を修正 (yt-dlpのinfo['is_live']/['live_status']から実際のライブ判定を記録しis_live()へ反映)
      + "${py.interpreter} ${patchDir + "/ytaudioformatstale-patch.py"}\n" # _get_track()がasr/audio_channelsを取得できない曲(ライブ配信のHLS系フォーマット等)でset_audio_format()呼び出し自体をスキップし、statusのaudioフィールドが前の曲のサンプルレート/チャンネル数のまま無期限に残留する不具合を修正 (新曲のuriを伴い常にset_audio_formatを呼び、値不明時はNoneにする)
      + "${py.interpreter} ${patchDir + "/ytfindalbumtracks-patch.py"}\n" # search()のalbum分岐がparseSearch()経由でSearchResult.albums(ブラウズ用プレースホルダ)のみを積み実トラックを一切返さず、find album "X"がヒットするアルバムが実在してもOKのまま常に0件になる不具合を修正 (albumToTracks()で実トラックを展開して追加)。併せてalbum/artist両タグ指定時にartist分岐(filter="artists")が優先されアルバム名がバックエンド検索に一切使われない問題を、album分岐をartistより先に判定する順序へ変更して解消
      + "${py.interpreter} ${patchDir + "/ytlibrarycachecap-patch.py"}\n" # self.TRACKS/ALBUMS/ARTISTS/IMAGES(videoId/browseId起点のライブラリキャッシュ)が上限の無いdictのままgetTrack()/playlistToTracks()/albumToTracks()/parseSearch()等50箇所超から書き込まれ続け、常駐サービスとして長時間稼働しブラウズ・検索を重ねるほどメモリが単調増加する不具合を修正 (_MPDART_CACHE/_audio_format_cacheと同じ考え方でdict継承の_BoundedLibraryCacheへ置換、各8192件超で挿入順(FIFO)に破棄。退避後の参照はキャッシュミスとして再取得されるだけで例外にはならない)
