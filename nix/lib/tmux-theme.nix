# tmux's rose-pine status bar, rendered in two flavours from one layout:
#
#   mk      the home-manager one (modules/home/terminal.nix): hex colours from the active
#           palette, plus the tmux-resurrect save time in status-right.
#   remote  configs/terminals/tmux/theme-remote.conf, for hosts home-manager never touches
#           (nssh targets). Committed, since those hosts have no Nix; scripts/check-generated.sh
#           fails when the file differs from `nix eval --raw --file nix/lib/tmux-theme.nix remote`.
#
# The remote flavour uses ANSI colour numbers rather than hex. An ssh target has no way to
# know the OS appearance, but the colours are resolved by the client terminal, so the bar
# follows the main machine's ghostty switching Rose Pine / Rose Pine Dawn with no side
# channel — the same trade lazygit / delta / fzf make in modules/home/cli.nix, at the cost of
# rose-pine's in-between shades being rounded to the 16 colours. It therefore does not read
# palettes.json (changing `active` leaves the file untouched), and one file serves both
# light and dark. The resurrect save time is left out: resurrect-status.sh is a
# home-manager output that does not exist on those hosts.
let
  # col: palette role -> tmux colour. `onAccent` is the text on an accent-coloured badge
  # (the session name, PREFIX); it is the base colour in hex but colour0 in ANSI, where base
  # itself is `default` (the terminal's own background).
  # header / statusRightNote: comment lines (each ending in a newline).
  # statusRightExtra: tmux format inserted before the date, or "".
  mkTheme =
    {
      col,
      header,
      statusRightNote,
      statusRightExtra,
    }:
    ''
      ${header}set -g status-position top
      set -g status-interval 5
      set -g status-justify left

      set -g status-style               "bg=${col "base"},fg=${col "subtle"}"
      set -g status-left-length 40
      set -g status-right-length 80
      set -g status-left  "#[bg=${col "pine"},fg=${col "onAccent"},bold] #S #[bg=${col "base"},fg=${col "pine"}]#[default] "
      ${statusRightNote}set -g status-right "#{?client_prefix,#[bg=${col "love"}#,fg=${col "onAccent"}#,bold] PREFIX #[default] ,}${statusRightExtra}#[fg=${col "muted"}]%Y-%m-%d #[fg=${col "foam"}]%H:%M "

      # inactive / active windows (tabs)
      set -g window-status-format         "#[fg=${col "muted"}] #I #W "
      set -g window-status-current-format "#[bg=${col "overlay"},fg=${col "iris"},bold] #I #W "
      set -g window-status-separator ""
      set -g window-status-activity-style "fg=${col "gold"}"

      # pane border / message / copy mode
      set -g pane-border-style        "fg=${col "overlay"}"
      set -g pane-active-border-style "fg=${col "pine"}"
      set -g message-style            "bg=${col "overlay"},fg=${col "text"}"
      set -g message-command-style    "bg=${col "overlay"},fg=${col "text"}"
      set -g mode-style               "bg=${col "hlMed"},fg=${col "text"}"
      set -g display-panes-active-colour "${col "iris"}"
      set -g display-panes-colour        "${col "muted"}"
      set -g clock-mode-colour           "${col "foam"}"
    '';

  # Role -> ANSI slot, the same mapping as windows/terminal/settings.json.tmpl. rose-pine's
  # subtle / hlMed have no ANSI slot of their own, so they borrow text / muted.
  ansi = {
    base = "default";
    onAccent = "colour0";
    overlay = "colour0";
    love = "colour1";
    pine = "colour2";
    gold = "colour3";
    foam = "colour4";
    iris = "colour5";
    text = "colour7";
    subtle = "colour7";
    muted = "colour8";
    hlMed = "colour8";
  };
in
{
  # p: a palette from lib/theme.nix (hex without '#'). resurrectStatus: path of the script
  # that prints the last tmux-resurrect save time.
  mk =
    p: resurrectStatus:
    mkTheme {
      col = role: "#${(p // { onAccent = p.base; }).${role}}";
      header = ''
        # rose-pine (generated from configs/theme/palettes.json — do not edit by hand)
      '';
      statusRightNote = ''
        # status-right, left to right:
        #   - PREFIX badge while the prefix key is armed (client_prefix). tmux redraws the status
        #     on client_prefix change, so it appears/disappears in real time (independent of interval).
        #   - 💾 HH:MM = last tmux-resurrect save time, so you can always see it saved without
        #     pressing anything. Read via a script because tmux would strftime-expand %-tokens in
        #     an inline #(); the script keeps the % inside itself. (continuum here has no
        #     #{continuum_status}, so this is the reliable way to surface the last save.)
      '';
      statusRightExtra = "#[fg=#${p.muted}]#(${resurrectStatus}) ";
    };

  remote = mkTheme {
    col = role: ansi.${role};
    header = ''
      # tmux theme for hosts that home-manager never touches — generated by
      # nix/lib/tmux-theme.nix (remote). DO NOT EDIT BY HAND.
      #
      # nssh 先 (リモートホスト) 専用。母艦では nix が生成する
      # ~/.config/tmux/theme.conf が使われ、こちらは読まれない
      # (tmux.conf 側で theme.conf の不在を条件にしている)。
      #
      # 色は hex ではなく ANSI 番号なので、解決するのは接続元の端末になる。母艦の
      # ghostty が Rose Pine / Rose Pine Dawn を切り替えれば、このバーは何も
      # 受け取らずにライト/ダークへ追従する。役割 → ANSI の対応は
      # windows/terminal/settings.json.tmpl (Windows Terminal のパレット) と同じ:
      #
      #   0 overlay  1 love  2 pine  3 gold  4 foam  5 iris  6 rose  7 text  8 muted
      #
      # 背景は `default` = 端末の背景そのもの。rose-pine の subtle / hlMed には
      # 対応する ANSI 枠が無いので、それぞれ text / muted に寄せてある。
    '';
    statusRightNote = ''
      # 母艦版と違い resurrect の保存時刻は出さない (プラグインがリモートに無いため)。
      # PREFIX バッジは client_prefix の変化で tmux が再描画するので interval に依らず即座に出る。
    '';
    statusRightExtra = "";
  };
}
