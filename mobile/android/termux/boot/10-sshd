#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot が起動のたびに走らせる (~/.termux/boot/ に置く)。スマホとタブレットの両方で使う。
# Termux のデータは最初のロック解除まで暗号化されているので、走るのはその後になる。

# SSH は tailnet のアドレスでだけ受ける (鍵のみ。sshd_config は README)。アドレスは Tailscale の
# 範囲 (100.64.0.0/10) のものを ifconfig から拾うので、端末ごとに書き換えなくてよい。Tailscale が
# アドレスを上げるまでは見つからないので、上がって sshd が bind できるまで繰り返す。
(
  while :; do
    addr=$(ifconfig 2>/dev/null | awk '$1 == "inet" && $2 ~ /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./ { print $2; exit }')
    [ -n "$addr" ] && sshd -o ListenAddress="$addr" && break
    sleep 15
  done
) &
