#!/data/data/com.termux/files/usr/bin/sh
# スマホの Termux:Boot が起動のたびに走らせる (~/.termux/boot/10-pixel に置く)。
# Termux のデータは最初のロック解除まで暗号化されているので、走るのはその後になる。

# 日本向けの Pixel は純正カメラのシャッター音を ENFORCED_AUDIBLE の音量グループで強制し、
# そのミュートは再起動で戻る。グループの番号は端末ごとに違い、この Pixel 7a では 5
# (7 は通知。dumpsys audio の "Legacy Stream Type 7 Volume Group Id" で確かめる)。
# Shizuku (thedjchi のフォーク) は Wi-Fi に繋がってから自分で起動するので、上がるのを待つ。
(
  until "$HOME/bin/rish" -c true >/dev/null 2>&1; do sleep 15; done
  "$HOME/bin/mute-shutter"
) &

# SSH は tailnet のアドレスでだけ受ける (鍵のみ。sshd_config は README)。Tailscale が
# アドレスを上げるまでは bind に失敗するので、通るまで繰り返す。
(
  until sshd -o ListenAddress=100.76.47.30; do sleep 15; done
) &
